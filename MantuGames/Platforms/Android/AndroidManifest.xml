<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
	<application android:allowBackup="true"
	             android:dataExtractionRules="@xml/data_extraction_rules"
	             android:fullBackupContent="@xml/backup_rules"
	             android:icon="@mipmap/app_icon"
	             android:roundIcon="@mipmap/app_icon_round"
	             android:supportsRtl="true"
	             tools:replace="android:name">
		<meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
		           android:value="ca-app-pub-7489032711560079~7098519092" />
		<meta-data android:name="com.google.android.play.billingclient.version"
		           android:value="8.1.0" />
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- Daily challenge reminder (local notification, Android 13+ asks the user first) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Advertising ID is used only for players who say they are 13 or older;
	     ad requests for children are child-directed, which stops the SDK sending it.
	     The Privacy Sandbox ad permissions are not needed and stay removed. -->
	<uses-permission android:name="com.google.android.gms.permission.AD_ID" />
	<uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
	<uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
	<uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
</manifest>