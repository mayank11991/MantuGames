<?xml version="1.0" encoding="utf-8"?>
<ContentPage BackgroundColor="{StaticResource NightBg}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MantuGames.Converters"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.MathGamePage"
>
    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="StringToColor" />
    </ContentPage.Resources>

    <AbsoluteLayout>
        <controls:ClayBackground Variant="Night" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              Padding="12,16,12,8" RowSpacing="8"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Style="{StaticResource NightCircle}" Grid.Column="0"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_back_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <controls:ThinkingBuddy Grid.Column="1" Text="{Binding LevelDisplay}" />
                <Border Style="{StaticResource CtaCircleOrange}" Grid.Column="2"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_pause_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="MathTimer" Grid.Row="2"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- PROGRESS BAR -->
            <Border Grid.Row="3"
                    BackgroundColor="#FFFFFF" StrokeThickness="0"
                    Padding="14,10" Margin="20,2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Questions"
                           FontSize="14" FontFamily="MadimiOne" FontAttributes="Bold"
                           TextColor="#6B7A90"
                           VerticalOptions="Center" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProgressText}"
                           FontSize="12" FontFamily="MadimiOne" FontAttributes="Bold"
                           TextColor="#6B7A90"
                           VerticalOptions="Center" />
                    <Border Style="{StaticResource ClayFrame}" Grid.Row="1" Grid.ColumnSpan="2"
                           BackgroundColor="#80FFFFFF" StrokeShape="RoundRectangle 8"
                           Padding="0" HeightRequest="10">
                        <BoxView x:Name="ProgressBar" BackgroundColor="Transparent"
                                 Color="{Binding ProgressBarColor}" HeightRequest="10"
                                 CornerRadius="8" HorizontalOptions="Start" />
                    </Border>
                </Grid>
            </Border>

            <!-- QUESTION + CHOICES -->
            <StackLayout Grid.Row="4" Spacing="16" VerticalOptions="Center">
                <!-- Question card -->
                <Border Style="{StaticResource NightCard}" StrokeShape="RoundRectangle 24"
                       Padding="24,20"
                       HorizontalOptions="Center" WidthRequest="300">
                    <Label x:Name="QuestionLabel"
                           Text="{Binding QuestionText}"
                           FontSize="20" FontFamily="MadimiOne" FontAttributes="Bold"
                           TextColor="#1F2A44"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           MaxLines="4" />
                </Border>

                <!-- 4 choice buttons -->
                <Grid x:Name="ChoicesGrid"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12" RowSpacing="12"
                      Padding="8,0">
                </Grid>
            </StackLayout>

            <!-- SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="5" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionCoinLabel" Style="{StaticResource CtaButtonYellow}"
                        FontSize="15" FontAttributes="Bold"
                        TextColor="#111114" BackgroundColor="#FFC83D"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolutionClicked" />
                <!-- <Label x:Name="SolutionCoinLabel" -->
                <!--        FontFamily="MadimiOne" -->
                <!--        FontSize="11" -->
                <!--        TextColor="#D9A400" -->
                <!--        HorizontalOptions="Center" /> -->
            </VerticalStackLayout>

        </Grid>

        <!-- WIN/LOSS POPUP -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
