<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MantuGames.Converters"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.MathGamePage">
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#0B0E14" Dark="#0B0E14" />
    </ContentPage.BackgroundColor>
    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="StringToColor" />
    </ContentPage.Resources>

    <AbsoluteLayout>

        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              Padding="12,16,12,8" RowSpacing="8"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ImageButton Grid.Column="0" Source="icon_back_round.svg" Padding="0" HeightRequest="48" WidthRequest="48" 
                        BackgroundColor="Transparent"
                       
                        Clicked="OnBackClicked" VerticalOptions="Center" />
                <Frame Grid.Column="1" BackgroundColor="#182136" CornerRadius="20"
                       Padding="12,6" HasShadow="False"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#F59E0B"
                           FontSize="16" FontFamily="Orbitron" FontAttributes="Bold" HorizontalOptions="Center" />
                </Frame>
                <ImageButton Grid.Column="2" Source="pause.svg"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="MathTimer" Grid.Row="2"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- PROGRESS BAR styled -->
            <Border Grid.Row="3"
                   
                    StrokeThickness="0"
                    Padding="14,10" Margin="20,2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Questions"
                           FontSize="14" FontFamily="Inter" FontAttributes="Bold"
                           TextColor="#9AA7BD"
                           VerticalOptions="Center" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProgressText}"
                           FontSize="12" FontFamily="Inter" FontAttributes="Bold"
                           TextColor="#9AA7BD"
                           VerticalOptions="Center" />
                    <Frame Grid.Row="1" Grid.ColumnSpan="2"
                           BackgroundColor="#33FFFFFF" CornerRadius="8"
                           Padding="0" HeightRequest="10" HasShadow="False">
                         <BoxView x:Name="ProgressBar" BackgroundColor="Transparent"
                                  Color="{Binding ProgressBarColor}" HeightRequest="10"
                                  CornerRadius="8" HorizontalOptions="Start" />
                    </Frame>
                </Grid>
            </Border>

            <!-- QUESTION + CHOICES -->
            <StackLayout Grid.Row="4" Spacing="16" VerticalOptions="Center">

                <!-- Question card -->
                <Frame BackgroundColor="#182136" CornerRadius="24"
                       Padding="24,28" HasShadow="True"
                       HorizontalOptions="Center" WidthRequest="280">
                    <Label x:Name="QuestionLabel"
                           Text="{Binding QuestionText}"
                           FontSize="36" FontFamily="Orbitron" FontAttributes="Bold"
                           TextColor="#E7ECF5"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <!-- 4 choice buttons — 2x2 grid -->
                <Grid x:Name="ChoicesGrid"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12" RowSpacing="12"
                      Padding="8,0">
                    <!-- Populated in code-behind -->
                </Grid>

            </StackLayout>

            <!-- SHOW SOLUTION -->
            <Button Grid.Row="5"
                    Text="Show Answer"
                    FontSize="15" FontAttributes="Bold"
                    TextColor="#160D02" BackgroundColor="#FF9F1C"
                    CornerRadius="20" HeightRequest="44"
                    Margin="40,0"
                    Clicked="OnShowSolutionClicked" />

        </Grid>

        <!-- WIN/LOSS POPUP -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>