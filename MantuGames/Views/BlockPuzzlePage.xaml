<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.BlockPuzzlePage">
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#0B0E14" Dark="#0B0E14" />
    </ContentPage.BackgroundColor>

    <AbsoluteLayout>

        <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,Auto,*,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR: back | level badge | pause -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                  Padding="4,0">
                <ImageButton Grid.Column="0" Source="icon_back_round.svg"
                             Padding="0" HeightRequest="48" WidthRequest="48"
                             BackgroundColor="Transparent" Clicked="OnBackClicked"
                             VerticalOptions="Center"/>
                <Frame Grid.Column="1" BackgroundColor="#182136" CornerRadius="20"
                       Padding="12,6" HasShadow="False"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#F97316"
                           FontSize="16" FontFamily="Orbitron" FontAttributes="Bold" HorizontalOptions="Center"/>
                </Frame>
                <ImageButton Grid.Column="2" Source="pause.svg"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="BlockTimer" Grid.Row="1"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

           <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="10">
               <Border BackgroundColor="#182136" StrokeThickness="0"
                       Padding="10,5" VerticalOptions="Center">
                   <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                   <StackLayout Spacing="0">
                       <Label Text="SCORE" TextColor="#9AA7BD" FontSize="9" FontFamily="Orbitron"
                              FontAttributes="Bold" HorizontalOptions="Center"/>
                       <Label Text="{Binding Score}" TextColor="#E7ECF5"
                              FontSize="13" FontFamily="Orbitron" FontAttributes="Bold" HorizontalOptions="Center"/>
                   </StackLayout>
               </Border>
               <Border BackgroundColor="#182136" StrokeThickness="0"
                       Padding="10,5" VerticalOptions="Center">
                   <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                   <StackLayout Spacing="0">
                       <Label Text="LINES" TextColor="#9AA7BD" FontSize="9" FontFamily="Orbitron"
                              FontAttributes="Bold" HorizontalOptions="Center"/>
                       <Label Text="{Binding LinesDisplay}" TextColor="#F97316"
                              FontSize="13" FontFamily="Orbitron" FontAttributes="Bold" HorizontalOptions="Center"/>
                   </StackLayout>
               </Border>
           </HorizontalStackLayout>
            
            
            <!-- GAME AREA -->
            <!-- Fill (not Center) so BoardContainer's actual bounds equal the
                 remaining space in this "*" row, after the top bar/score row/
                 next-piece panel take theirs. BuildBoard() measures this
                 container's real size instead of guessing from screen size,
                 so the board can never grow into the panel below it. -->
            <Border Grid.Row="3" x:Name="BoardContainer"
                    BackgroundColor="#0F1420" StrokeThickness="2" Stroke="#2EFFFFFF"
                    VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRotate"/>
                    <PanGestureRecognizer PanUpdated="OnPanBoard"/>
                </Border.GestureRecognizers>
                <Grid x:Name="BoardGrid" RowSpacing="0" ColumnSpacing="0"
                      HorizontalOptions="Center" VerticalOptions="Center"
                      InputTransparent="True"/>
            </Border>

            <!-- BOTTOM PANEL: Next piece + Show Solution -->
            <VerticalStackLayout Grid.Row="4" Spacing="6">
                <Border x:Name="NextPieceOverlay"
                        BackgroundColor="#131A29" StrokeThickness="1" Stroke="#2EFFFFFF"
                        HorizontalOptions="Center" Padding="10,6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="NEXT" TextColor="#9AA7BD" FontSize="12" FontFamily="Orbitron"
                               FontAttributes="Bold" VerticalOptions="Center"/>
                        <Grid x:Name="NextPieceGrid" RowSpacing="0" ColumnSpacing="0"
                              HorizontalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Button x:Name="SolutionButton"
                        Text="Show Solution"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#160D02" BackgroundColor="#FF9F1C"
                        CornerRadius="20" HeightRequest="40"
                        Margin="60,0"
                        Clicked="OnShowSolutionClicked" />
            </VerticalStackLayout>

        </Grid>

        <controls:GameResultPopup x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel" RetryRequested="OnRetry"/>

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
