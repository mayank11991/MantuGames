<?xml version="1.0" encoding="utf-8"?>
<ContentPage BackgroundColor="{StaticResource NightBg}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.BlockPuzzlePage"
>

    <AbsoluteLayout>
        <controls:ClayBackground Variant="Night" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,Auto,*,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR: back | level badge | pause -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                  Padding="4,0">
                <Border Style="{StaticResource NightCircle}" Grid.Column="0"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_back_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <controls:ThinkingBuddy Grid.Column="1" Text="{Binding LevelDisplay}" />
                <Border Style="{StaticResource CtaCircleOrange}" Grid.Column="2"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_pause_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="BlockTimer" Grid.Row="1"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="10">
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0"
                        Padding="10,5" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <StackLayout Spacing="0">
                        <Label Text="SCORE" TextColor="#6B7A90" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding Score}" TextColor="#1F2A44"
                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0"
                        Padding="10,5" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <StackLayout Spacing="0">
                        <Label Text="LINES" TextColor="#6B7A90" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding LinesDisplay}" TextColor="#FF8A3D"
                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>
            </HorizontalStackLayout>

            <!-- GAME AREA -->
            <Border Grid.Row="3" x:Name="BoardContainer"
                    BackgroundColor="#FFFFFF" StrokeThickness="1.5" Stroke="#D6E4F0"
                    VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRotate"/>
                    <PanGestureRecognizer PanUpdated="OnPanBoard"/>
                </Border.GestureRecognizers>
                <Grid HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                    <Grid x:Name="BoardGrid" RowSpacing="0" ColumnSpacing="0" InputTransparent="True"/>
                    <!-- Line-clear effects (flash + flying shards) are drawn here -->
                    <AbsoluteLayout x:Name="FxLayer" InputTransparent="True"/>
                </Grid>
            </Border>

            <!-- BOTTOM PANEL: Next piece + Show Solution -->
            <VerticalStackLayout Grid.Row="4" Spacing="6">
                <Border x:Name="NextPieceOverlay"
                        BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#D6E4F0"
                        HorizontalOptions="Center" Padding="10,6">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="NEXT" TextColor="#6B7A90" FontSize="12" FontFamily="MadimiOne"
                               FontAttributes="Bold" VerticalOptions="Center"/>
                        <Grid x:Name="NextPieceGrid" RowSpacing="0" ColumnSpacing="0"
                              HorizontalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="2" Margin="60,0">
                    <Button x:Name="SolutionCoinLabel" Style="{StaticResource CtaButtonYellow}"
                            FontSize="14" FontAttributes="Bold"
                            TextColor="#111114" BackgroundColor="#FFC83D"
                            CornerRadius="24" HeightRequest="50"
                            Clicked="OnShowSolutionClicked" />
                    <!-- <Label x:Name="SolutionCoinLabel" -->
                    <!--        FontFamily="MadimiOne" -->
                    <!--        FontSize="11" -->
                    <!--        TextColor="#D9A400" -->
                    <!--        HorizontalOptions="Center" /> -->
                </VerticalStackLayout>
            </VerticalStackLayout>

        </Grid>

        <controls:GameResultPopup x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel" RetryRequested="OnRetry"/>

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
