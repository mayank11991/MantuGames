<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B0E14"
             x:Class="MantuGames.Views.SplashPage">

    <Grid x:Name="Root" HorizontalOptions="Fill" VerticalOptions="Fill">
        <GraphicsView x:Name="DustCanvas"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      InputTransparent="True" />
        <VerticalStackLayout x:Name="CenterStack"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="10">
            <HorizontalStackLayout x:Name="MantuRow"
                                   HorizontalOptions="Center"
                                   Spacing="4" />
            <Label x:Name="GamingsLabel"
                   Text="GAMINGS"
                   FontFamily="Orbitron"
                   FontSize="14"
                   TextColor="#22D3EE"
                   HorizontalOptions="Center"
                   CharacterSpacing="8"
                   Opacity="0"
                   Padding="10,0,10,10" />
            <Image x:Name="SlothImage"
                   Source="sloth.png"
                   HeightRequest="120"
                   WidthRequest="120"
                   HorizontalOptions="Center"
                   Opacity="0"
                   Margin="0,4,0,0" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
