<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F7EFFF"
             x:Class="MantuGames.Views.SplashPage">

    <Grid x:Name="Root" HorizontalOptions="Fill" VerticalOptions="Fill">
        <controls:ClayBackground AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <GraphicsView x:Name="DustCanvas"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      InputTransparent="True" />
        <VerticalStackLayout x:Name="CenterStack"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="10">
            <Grid x:Name="MantuRow"
                  HorizontalOptions="Center"
                  ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <Label x:Name="L0" Text="M" Grid.Column="0"
                       FontFamily="MadimiOne" FontSize="46"
                       FontAttributes="Bold" TextColor="#3D2C4E"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label x:Name="L1" Text="A" Grid.Column="1"
                       FontFamily="MadimiOne" FontSize="46"
                       FontAttributes="Bold" TextColor="#3D2C4E"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label x:Name="L2" Text="N" Grid.Column="2"
                       FontFamily="MadimiOne" FontSize="46"
                       FontAttributes="Bold" TextColor="#3D2C4E"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label x:Name="L3" Text="T" Grid.Column="3"
                       FontFamily="MadimiOne" FontSize="46"
                       FontAttributes="Bold" TextColor="#3D2C4E"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label x:Name="L4" Text="U" Grid.Column="4"
                       FontFamily="MadimiOne" FontSize="46"
                       FontAttributes="Bold" TextColor="#3D2C4E"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Grid>
            <Label x:Name="GamingsLabel"
                   Text="GAMINGS"
                   FontFamily="MadimiOne"
                   FontSize="16"
                   TextColor="#2F9E7F"
                   HorizontalOptions="Center"
                   CharacterSpacing="8"
                   Opacity="0"
                   Padding="10,0,10,10" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
