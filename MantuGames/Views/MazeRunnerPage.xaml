<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.MazeRunnerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
>

    <AbsoluteLayout>
        <controls:ClayBackground AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <Grid x:Name="MazeRootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- Row 0 : header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6"
                  Padding="12,16,12,0">

                <Border Style="{StaticResource ClayFrame}" Grid.Column="0" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>

                <Border Style="{StaticResource ClayFrame}" Grid.Column="1"
                       BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="LevelLabel"
                           FontFamily="MadimiOne"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#5B7CFA"
                           HorizontalOptions="Center" />
                </Border>

                <Border Style="{StaticResource ClayFrame}" Grid.Column="2" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- Row 1 : timer -->
            <controls:GameTimerView x:Name="MazeTimer" Grid.Row="1" Margin="0,2,0,0" />

            <!-- Row 2 : moves label -->
            <Label Grid.Row="2"
                   x:Name="MovesLabel"
                   Text="Moves: 0"
                   FontFamily="MadimiOne"
                   FontSize="13"
                   TextColor="#7C6A8E"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,2,0,0" />

            <!-- Row 3 : maze canvas -->
            <Border Grid.Row="3"
                    BackgroundColor="#33B49CCF"
                    StrokeThickness="2"
                    Stroke="#D8CAE8"
                    Margin="16,8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid x:Name="MazeOverlay">
                    <GraphicsView x:Name="MazeCanvas"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                        <GraphicsView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPanMaze" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <Image x:Name="PlayerImage"
                           Source="cat.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           InputTransparent="True"
                           Aspect="AspectFit" />
                    <Image x:Name="DestinationImage"
                           Source="destination.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           InputTransparent="True"
                           Aspect="AspectFit" />
                </Grid>
            </Border>

            <!-- Row 4 : Show Solution -->
            <VerticalStackLayout Grid.Row="4" Spacing="2" Margin="60,4,60,12">
                <Button x:Name="SolutionCoinLabel"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#3D2C4E" BackgroundColor="#FFA94D"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolutionClicked" />
                <!-- <Label x:Name="SolutionCoinLabel" -->
                <!--        FontFamily="MadimiOne" -->
                <!--        FontSize="11" -->
                <!--        TextColor="#D9A400" -->
                <!--        HorizontalOptions="Center" /> -->
            </VerticalStackLayout>

        </Grid>

        <!-- Overlay popup -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            IsVisible="False"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
