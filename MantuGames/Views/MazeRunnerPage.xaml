<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MantuGames.Views.MazeRunnerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    >
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#0B0E14" Dark="#0B0E14" />
    </ContentPage.BackgroundColor>

    <AbsoluteLayout>

        <Grid x:Name="MazeRootGrid" RowDefinitions="Auto,Auto,Auto,3*,2*,Auto"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- ── Row 0 : header ─────────────────────────────────────────── -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6"
                  Padding="12,16,12,0">

                <ImageButton Grid.Column="0"
                        Source="icon_back_round.svg"
                        HeightRequest="48" WidthRequest="48"
                        BackgroundColor="Transparent" Padding="0"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />

                <Frame Grid.Column="1"
                       BackgroundColor="#182136" CornerRadius="20"
                       Padding="12,6" HasShadow="False"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="LevelLabel"
                           FontFamily="Orbitron"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#3B82F6"
                           HorizontalOptions="Center" />
                </Frame>

                <ImageButton Grid.Column="2" Source="pause.svg"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- ── Row 1 : timer ──────────────────────────────────────────── -->
            <controls:GameTimerView x:Name="MazeTimer" Grid.Row="1" Margin="0,2,0,0" />

            <!-- ── Row 2 : moves label (below timer) ─────────────────────── -->
            <Label Grid.Row="2"
                   x:Name="MovesLabel"
                   Text="Moves: 0"
                   FontFamily="Orbitron"
                   FontSize="13"
                   TextColor="#9AA7BD"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,2,0,0" />

            <!-- ── Row 3 : maze canvas ───────────────────────────────────── -->
            <Border Grid.Row="3"
                    BackgroundColor="#0F1420"
                    StrokeThickness="1"
                    Stroke="#2EFFFFFF"
                    Margin="12,4,12,4">
                <Grid x:Name="MazeOverlay">
                    <GraphicsView x:Name="MazeCanvas"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                        <GraphicsView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPanMaze" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <Image x:Name="PlayerImage"
                           Source="cat.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           InputTransparent="True"
                           Aspect="AspectFit" />
                    <Image x:Name="DestinationImage"
                           Source="destination.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           InputTransparent="True"
                           Aspect="AspectFit" />
                </Grid>
            </Border>

            <!-- ── Row 4 : swipe pad (mouse-pad style) ──────────────────── -->
            <Border Grid.Row="4"
                    BackgroundColor="#182136"
                    StrokeThickness="1"
                    Stroke="#2EFFFFFF"
                    Margin="16,4,16,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPadPan" />
                </Border.GestureRecognizers>
                <Grid>
                    <Label Text="Swipe to move"
                           FontFamily="Inter"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#3B82F6"
                           Opacity="0.55"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="PadDirectionLabel"
                           FontFamily="Orbitron"
                           FontSize="11"
                           TextColor="#9AA7BD"
                           Opacity="0.5"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           Margin="0,0,0,8"
                           InputTransparent="True" />
                </Grid>
            </Border>

            <!-- ── Row 5 : Show Solution (below finger pad) ──────────────── -->
            <Button Grid.Row="5"
                    x:Name="SolutionButton"
                    Text="Show Solution"
                    FontSize="13" FontAttributes="Bold"
                    TextColor="#160D02" BackgroundColor="#FF9F1C"
                    CornerRadius="20" HeightRequest="40"
                    Margin="60,2,60,12"
                    Clicked="OnShowSolutionClicked" />

        </Grid>

        <!-- ── Overlay popup ─────────────────────────────────────────── -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            IsVisible="False"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>