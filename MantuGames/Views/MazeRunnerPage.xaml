<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MantuGames.Views.MazeRunnerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    >
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#FBF4ED" Dark="#1F1B1B" />
    </ContentPage.BackgroundColor>

    <AbsoluteLayout>

        <Grid x:Name="MazeRootGrid" RowDefinitions="Auto,Auto,3*,Auto,2*"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- ── Row 0 : header ─────────────────────────────────────────── -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                  ColumnSpacing="6"
                  Padding="8,44,12,0">

                <ImageButton Grid.Column="0"
                        Source="icon_back_round.svg"
                        HeightRequest="48" WidthRequest="48"
                        BackgroundColor="Transparent" Padding="0"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />

                <Label Grid.Column="1"
                       x:Name="LevelLabel"
                       FontFamily="BrickSans"
                       FontSize="15"
                       TextColor="White"
                       VerticalOptions="Center"
                       Margin="4,0" />

                <Label Grid.Column="2"
                       Text="🏆" BackgroundColor="Transparent"
                       FontSize="26"
                       VerticalOptions="Center"
                       Margin="0,0,6,0" />

                <!-- timer badge -->
                <Border Grid.Column="3"
                         BackgroundColor="#335A5670"
                         StrokeThickness="0"
                         VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label x:Name="TimerLabel"
                           Text="⏱ 1:20"
                           FontFamily="BrickSans"
                           FontSize="13"
                           TextColor="#F0E6D8"
                           Padding="12,6" />
                </Border>

                <ImageButton Grid.Column="4" Source="information.png"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="0,0,4,0"
                             Clicked="OnRulesClicked"
                             VerticalOptions="Center" />

                <ImageButton Grid.Column="5" Source="pause.png"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- ── Row 1 : timer bar ──────────────────────────────────────── -->
            <ProgressBar Grid.Row="1"
                         x:Name="TimerBar"
                         Progress="1"
                         ProgressColor="#D4B896"
                         Margin="20,6,20,4" />

            <!-- ── Row 2 : maze canvas ───────────────────────────────────── -->
            <Border Grid.Row="2"
                    BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E3020}"
                    StrokeThickness="0"
                    Margin="12,4,12,4">
                <Grid x:Name="MazeOverlay">
                    <GraphicsView x:Name="MazeCanvas"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                        <GraphicsView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnPanMaze" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <Image x:Name="PlayerImage"
                           Source="cat.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           InputTransparent="True"
                           Aspect="AspectFit" />
                    <Image x:Name="DestinationImage"
                           Source="destination.png"
                           HorizontalOptions="Start"
                           VerticalOptions="Start"
                           InputTransparent="True"
                           Aspect="AspectFit" />
                </Grid>
            </Border>

            <!-- ── Row 3 : moves label (merged with D-pad) ────────────────── -->

            <!-- ── Row 3 : moves label ────────────────────────────────────── -->
            <Label Grid.Row="3"
                   x:Name="MovesLabel"
                   Text="Moves: 0"
                   FontFamily="BrickSans"
                   FontSize="13"
                   TextColor="#F0E6D8"
                   HorizontalOptions="Center"
                   Margin="0,2" />

            <!-- ── Row 4 : D-pad controls ──────────────────────────────── -->
            <Grid Grid.Row="4"
                  RowDefinitions="*,*,*"
                  ColumnDefinitions="*,*"
                  Margin="16,4,16,24"
                  RowSpacing="8" ColumnSpacing="8">

                <Border Grid.Row="0" Grid.ColumnSpan="2"
                        BackgroundColor="#B0DCC8A8"
                        StrokeThickness="0"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMoveUp" />
                    </Border.GestureRecognizers>
                    <Label Text="▲" FontSize="32" TextColor="#5D4037"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="#B0DCC8A8"
                        StrokeThickness="0"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMoveLeft" />
                    </Border.GestureRecognizers>
                    <Label Text="◀" FontSize="32" TextColor="#5D4037"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="#B0DCC8A8"
                        StrokeThickness="0"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMoveRight" />
                    </Border.GestureRecognizers>
                    <Label Text="▶" FontSize="32" TextColor="#5D4037"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2"
                        BackgroundColor="#B0DCC8A8"
                        StrokeThickness="0"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMoveDown" />
                    </Border.GestureRecognizers>
                    <Label Text="▼" FontSize="32" TextColor="#5D4037"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

            </Grid>

        </Grid>

        <!-- ── Overlay popup ─────────────────────────────────────────── -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            IsVisible="False"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:RulesPopup x:Name="RulesPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>