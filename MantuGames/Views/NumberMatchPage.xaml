<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.NumberMatchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False">
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#0B0E14" Dark="#0B0E14" />
    </ContentPage.BackgroundColor>

    <AbsoluteLayout>
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,0,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ImageButton Grid.Column="0"
                        Source="icon_back_round.svg" HeightRequest="48" WidthRequest="48"
                        BackgroundColor="Transparent" Padding="0"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />

                <Border Grid.Column="1" BackgroundColor="#182136"
                        StrokeThickness="0" Padding="16,6"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Label Text="{Binding LevelDisplay}" TextColor="#F97316"
                           FontSize="16" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                </Border>

                <ImageButton Grid.Column="2" Source="pause.svg"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- 8x8 NUMBER GRID -->
            <Border Grid.Row="2" BackgroundColor="#111827" StrokeThickness="0"
                    Padding="6">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <CollectionView x:Name="NumberGrid"
                                ItemsSource="{Binding Cells}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="9"
                                         HorizontalItemSpacing="4"
                                         VerticalItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding CellBg}"
                                    StrokeThickness="1"
                                    Stroke="#334155"
                                    HeightRequest="44"
                                    WidthRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CellTappedCommand}"
                                                          CommandParameter="{Binding Index}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Value}"
                                       TextColor="{Binding ValueTextColor}"
                                       FontSize="18"
                                       FontFamily="MomoTrustDisplay"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding TextVisibility}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- SCORE -->
            <Border Grid.Row="3" BackgroundColor="#182136" StrokeThickness="0"
                    Padding="16,8">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackLayout Grid.Column="0" Spacing="0">
                        <Label Text="SCORE" TextColor="#9AA7BD" FontSize="9" FontFamily="MomoTrustDisplay"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Score}" TextColor="#22D3EE"
                               FontSize="18" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                    <StackLayout Grid.Column="2" Spacing="0">
                        <Label Text="MOVES" TextColor="#9AA7BD" FontSize="9" FontFamily="MomoTrustDisplay"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Moves}" TextColor="#F97316"
                               FontSize="18" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Border>

            <!-- ADD NUMBERS -->
            <Border Grid.Row="4" StrokeThickness="0"
                    Padding="24,12"
                    HorizontalOptions="Center">
                <Border.BackgroundColor>
                    <Binding Path="AddButtonColor" />
                </Border.BackgroundColor>
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddNumbers" />
                </Border.GestureRecognizers>
                <Label Text="{Binding AddButtonText}" TextColor="White"
                       FontSize="14" FontFamily="MomoTrustDisplay" FontAttributes="Bold" />
            </Border>

        </Grid>

        <!-- POPUPS -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />
    </AbsoluteLayout>
</ContentPage>
