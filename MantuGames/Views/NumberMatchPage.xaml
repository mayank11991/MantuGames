<?xml version="1.0" encoding="utf-8"?>
<ContentPage BackgroundColor="{StaticResource NightBg}"
    x:Class="MantuGames.Views.NumberMatchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
>

    <AbsoluteLayout>
        <controls:ClayBackground Variant="Night" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,0,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Style="{StaticResource NightCircle}" Grid.Column="0"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_back_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <controls:ThinkingBuddy Grid.Column="1" Text="{Binding LevelDisplay}" />
                <Border Style="{StaticResource CtaCircleOrange}" Grid.Column="2"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_pause_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- 8x8 NUMBER GRID -->
            <Border Grid.Row="2" BackgroundColor="#FFFFFF" StrokeThickness="2" Stroke="#D6E4F0"
                    Padding="6" Margin="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <CollectionView x:Name="NumberGrid"
                                ItemsSource="{Binding Cells}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="9"
                                         HorizontalItemSpacing="4"
                                         VerticalItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding CellBg}"
                                    StrokeThickness="1"
                                    Stroke="#D6E4F0"
                                    HeightRequest="44"
                                    WidthRequest="44">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CellTappedCommand}"
                                                          CommandParameter="{Binding Index}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Value}"
                                       TextColor="{Binding ValueTextColor}"
                                       FontSize="18"
                                       FontFamily="MadimiOne"
                                       FontAttributes="Bold"
                                       IsVisible="{Binding TextVisibility}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- SCORE -->
            <Border Grid.Row="3" BackgroundColor="#FFFFFF" StrokeThickness="0"
                    Padding="16,8" Margin="40,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackLayout Grid.Column="0" Spacing="0">
                        <Label Text="SCORE" TextColor="#6B7A90" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Score}" TextColor="#FF8A3D"
                               FontSize="18" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                    <StackLayout Grid.Column="2" Spacing="0">
                        <Label Text="MOVES" TextColor="#6B7A90" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Moves}" TextColor="#FF8A3D"
                               FontSize="18" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Border>

            <!-- ADD NUMBERS -->
            <Border Grid.Row="4" StrokeThickness="0"
                    Padding="28,12" Margin="60,0"
                    Shadow="{x:Null}"
                    HorizontalOptions="Center">
                <Border.BackgroundColor>
                    <Binding Path="AddButtonColor" />
                </Border.BackgroundColor>
                <Border.StrokeShape><RoundRectangle CornerRadius="999" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddNumbers" />
                </Border.GestureRecognizers>
                <Label Text="{Binding AddButtonText}" TextColor="{Binding AddButtonTextColor}"
                       FontSize="15" FontFamily="Baloo2ExtraBold" />
            </Border>

        </Grid>

        <!-- POPUPS -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />
    </AbsoluteLayout>
</ContentPage>
