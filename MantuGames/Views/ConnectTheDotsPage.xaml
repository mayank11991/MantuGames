<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.ConnectTheDotsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False">
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#0B0E14" Dark="#0B0E14" />
    </ContentPage.BackgroundColor>

    <AbsoluteLayout>

        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,*,Auto"
              Padding="12,16,12,8" RowSpacing="8"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR: Back + Level + Pause -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ImageButton Grid.Column="0"
                        Source="icon_back_round.svg" HeightRequest="48" WidthRequest="48"
                        BackgroundColor="Transparent" Padding="0"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />

                <Frame Grid.Column="1" BackgroundColor="#182136" CornerRadius="20"
                       Padding="12,6" HasShadow="False"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#F97316"
                           FontSize="16" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                </Frame>

                <ImageButton Grid.Column="2" Source="pause.svg"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="TimerView" Grid.Row="1"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- GAME CANVAS -->
            <GraphicsView x:Name="GameCanvas"
                          Grid.Row="2"
                          BackgroundColor="Transparent"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill" />

            <!-- DIFFICULTY + HINT -->
            <HorizontalStackLayout Grid.Row="3"
                                   HorizontalOptions="Center" Spacing="10">
                <Border BackgroundColor="#182136" StrokeThickness="0"
                        Padding="12,6" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <StackLayout Spacing="0">
                        <Label Text="DIFFICULTY" TextColor="#9AA7BD" FontSize="9" FontFamily="MomoTrustDisplay"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Difficulty}" TextColor="#F97316"
                               FontSize="13" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
            </HorizontalStackLayout>

        </Grid>

        <!-- POPUPS -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
