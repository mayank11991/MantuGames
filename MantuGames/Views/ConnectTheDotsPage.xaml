<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MantuGames.Views.ConnectTheDotsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    BackgroundColor="#0D1117"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,48,16,12" BackgroundColor="#0D1117">
            <ImageButton
                Grid.Column="0"
                Source="icon_back_round"
                HeightRequest="40" WidthRequest="40"
                BackgroundColor="Transparent" Padding="0"
                Clicked="OnBackClicked"
                VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Border
                    BackgroundColor="#1A2332"
                    StrokeThickness="0"
                    Padding="12,4"
                    HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label
                        x:Name="DifficultyLabel"
                        Text="EASY"
                        FontFamily="MomoTrustDisplay"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#E7ECF5"
                        HorizontalOptions="Center" />
                </Border>
                <Label
                    x:Name="LevelLabel"
                    Text="Level 1"
                    FontFamily="MomoTrustDisplay"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#E7ECF5"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>

            <ImageButton
                Grid.Column="2"
                Source="icon_restart"
                HeightRequest="40" WidthRequest="40"
                BackgroundColor="Transparent" Padding="0"
                Clicked="OnRestartClicked"
                VerticalOptions="Center" />
        </Grid>

        <!-- Game Grid — takes all remaining space -->
        <Grid Grid.Row="1" x:Name="GameAreaGrid" Padding="8">
            <GraphicsView
                x:Name="GameCanvas"
                Drawable="{Binding Drawable}"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <GraphicsView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                    <TapGestureRecognizer Tapped="OnCanvasTapped" NumberOfTapsRequired="1" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="16,8,16,24" BackgroundColor="#0D1117">
            <Label
                Grid.Column="0"
                x:Name="CoinsLabel"
                Text="💰 0"
                FontFamily="MomoTrustDisplay"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#FF9F1C"
                VerticalOptions="Center" />

            <ImageButton
                Grid.Column="1"
                Source="info.svg"
                HeightRequest="32" WidthRequest="32"
                BackgroundColor="Transparent" Padding="0"
                Clicked="OnRulesClicked"
                VerticalOptions="Center" />
        </Grid>
    </Grid>

    <controls:GameResultPopup x:Name="ResultPopup" IsVisible="False" />
    <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False" />
    <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False" />
    <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False" />
    <controls:RulesPopup x:Name="RulesPopup" IsVisible="False" />

</ContentPage>
