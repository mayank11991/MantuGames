<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.ConnectTheDotsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    BackgroundColor="#1B2838"
    Shell.NavBarIsVisible="False">

    <AbsoluteLayout>

        <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,*,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR: back | level badge | pause -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                  Padding="4,0">
                <ImageButton Grid.Column="0" Source="icon_back_round.svg"
                             Padding="0" HeightRequest="48" WidthRequest="48"
                             BackgroundColor="Transparent" Clicked="OnBackClicked"
                             VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Frame BackgroundColor="#182136" CornerRadius="20"
                           Padding="12,6" HasShadow="False"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label x:Name="LevelBadge" TextColor="#F97316"
                               FontSize="16" FontFamily="MomoTrustDisplay" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Frame>
                    <Label x:Name="DifficultyLabel" Text="MEDIUM"
                           FontFamily="MomoTrustDisplay" FontSize="11" FontAttributes="Bold"
                           TextColor="#9AA7BD" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="2" Source="pause.svg"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0" Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="CtdTimer" Grid.Row="1"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- GAME AREA -->
            <GraphicsView x:Name="GameCanvas"
                          Grid.Row="2"
                          BackgroundColor="Transparent"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill" />

            <!-- HINT BUTTON -->
            <HorizontalStackLayout Grid.Row="3"
                                   HorizontalOptions="End"
                                   Padding="4,4,16,4">
                <Border BackgroundColor="#FF9F1C"
                        StrokeThickness="0"
                        Padding="12" CornerRadius="20"
                        WidthRequest="44" HeightRequest="44">
                    <Grid>
                        <Label Text="💡" FontSize="20"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </HorizontalStackLayout>

        </Grid>

        <controls:GameResultPopup x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel" RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
