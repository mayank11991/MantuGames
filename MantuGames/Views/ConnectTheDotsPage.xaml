<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.ConnectTheDotsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#1B2838"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,48,16,12">
            <ImageButton Grid.Column="0"
                         Source="icon_back_round"
                         WidthRequest="44" HeightRequest="44"
                         BackgroundColor="Transparent"
                         Padding="0"
                         Clicked="OnBackClicked" />

            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                <Label x:Name="DifficultyLabel"
                       Text="MEDIUM"
                       FontFamily="MomoTrustDisplay"
                       FontSize="12" FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center"
                       BackgroundColor="#2A3A4A"
                       Padding="16,4"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="LevelLabel"
                       Text="Level 1"
                       FontFamily="MomoTrustDisplay"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <ImageButton Grid.Column="2"
                         Source="icon_restart"
                         WidthRequest="44" HeightRequest="44"
                         BackgroundColor="Transparent"
                         Padding="0"
                         Clicked="OnRestartClicked" />
        </Grid>

        <!-- Game Grid with overlay -->
        <Grid Grid.Row="1" Padding="4">
            <GraphicsView x:Name="GameCanvas"
                          BackgroundColor="Transparent"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill" />
            <BoxView x:Name="TouchOverlay"
                     BackgroundColor="Transparent"
                     InputTransparent="False"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />
        </Grid>

        <!-- Bottom: Hints -->
        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="End"
                               Padding="16,8,24,32"
                               Spacing="4">
            <Border BackgroundColor="#FF9F1C"
                    StrokeThickness="0"
                    Padding="12"
                    WidthRequest="52" HeightRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>
                <Grid>
                    <Label Text="💡"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="HintsLabel"
                           Text="2"
                           FontFamily="MomoTrustDisplay"
                           FontSize="10" FontAttributes="Bold"
                           TextColor="#1B2838"
                           HorizontalOptions="End"
                           VerticalOptions="Start"
                           Margin="0,-2,-2,0" />
                </Grid>
            </Border>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
