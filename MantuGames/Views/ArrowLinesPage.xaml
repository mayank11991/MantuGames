<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.ArrowLinesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    xmlns:local="clr-namespace:MantuGames.Views"
    Shell.NavBarIsVisible="False"
>

    <AbsoluteLayout>
        <Image Source="app_bg.png" Aspect="AspectFill"
               AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" />
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- Row 0: Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Frame Grid.Column="0" BackgroundColor="#182136" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="#182136" CornerRadius="20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#F97316"
                           FontSize="16" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                </Frame>
                <Frame Grid.Column="2" BackgroundColor="#182136" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Frame>
            </Grid>

            <!-- Row 1: Status + Hearts -->
            <Border Grid.Row="1" BackgroundColor="#182136" StrokeThickness="0"
                    Padding="12,8" Margin="40,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackLayout Grid.Column="0" Spacing="0">
                        <Label Text="CLEARED" TextColor="#9AA7BD" FontSize="9" FontFamily="MomoTrustDisplay"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding ArrowsCleared}" TextColor="#22D3EE"
                               FontSize="18" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                    <Label Grid.Column="1" x:Name="HeartsLabel"
                           FontFamily="MomoTrustDisplay"
                           FontSize="18"
                           TextColor="#F43F5E"
                           VerticalOptions="Center"
                           Margin="8,0,0,0" />
                    <StackLayout Grid.Column="2" Spacing="0">
                        <Label Text="MOVES" TextColor="#9AA7BD" FontSize="9" FontFamily="MomoTrustDisplay"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Moves}" TextColor="#F97316"
                               FontSize="18" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Row 2: Arrow Grid (GraphicsView) -->
            <GraphicsView Grid.Row="2"
                          x:Name="ArrowGraphics"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill"
                          BackgroundColor="Transparent" />

            <!-- Row 3: Remaining -->
            <Label Grid.Row="3" Text="{Binding RemainingText}" TextColor="#9AA7BD"
                   FontSize="13" FontFamily="MomoTrustDisplay"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <!-- Row 4: Show Solution -->
            <VerticalStackLayout Grid.Row="4" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionButton"
                        Text="💡 Show Solution"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#1E1B4B" BackgroundColor="#F5A623"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolution" />
                <Label x:Name="SolutionCoinLabel"
                       FontFamily="MomoTrustDisplay"
                       FontSize="11"
                       TextColor="#DBD748"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </Grid>

        <!-- Popups -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />
    </AbsoluteLayout>
</ContentPage>
