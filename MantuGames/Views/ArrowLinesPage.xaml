<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.ArrowLinesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    xmlns:local="clr-namespace:MantuGames.Views"
    Shell.NavBarIsVisible="False"
>

    <AbsoluteLayout>
        <controls:ClayBackground AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- Row 0: Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Style="{StaticResource ClayFrame}" Grid.Column="0" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <Border Style="{StaticResource ClayFrame}" Grid.Column="1" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#FF8C5A"
                           FontSize="16" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                </Border>
                <Border Style="{StaticResource ClayFrame}" Grid.Column="2" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- Row 1: Status + Hearts -->
            <Border Grid.Row="1" BackgroundColor="#FFFDFA" StrokeThickness="0"
                    Padding="12,8" Margin="40,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackLayout Grid.Column="0" Spacing="0">
                        <Label Text="CLEARED" TextColor="#7C6A8E" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding ArrowsCleared}" TextColor="#6D4AFF"
                               FontSize="18" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                    <Label Grid.Column="1" x:Name="HeartsLabel"
                           FontFamily="MadimiOne"
                           FontSize="18"
                           TextColor="#E0566F"
                           VerticalOptions="Center"
                           Margin="8,0,0,0" />
                    <StackLayout Grid.Column="2" Spacing="0">
                        <Label Text="MOVES" TextColor="#7C6A8E" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding Moves}" TextColor="#FF8C5A"
                               FontSize="18" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Row 2: Arrow Grid (GraphicsView) -->
            <GraphicsView Grid.Row="2"
                          x:Name="ArrowGraphics"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill"
                          BackgroundColor="Transparent" />

            <!-- Row 3: Remaining -->
            <Label Grid.Row="3" Text="{Binding RemainingText}" TextColor="#7C6A8E"
                   FontSize="13" FontFamily="MadimiOne"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <!-- Row 4: Show Solution -->
            <VerticalStackLayout Grid.Row="4" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionCoinLabel"
                        Text="💡 Show Solution"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#3D2C4E" BackgroundColor="#FFA94D"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolution" />
            </VerticalStackLayout>

        </Grid>

        <!-- Popups -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />
    </AbsoluteLayout>
</ContentPage>
