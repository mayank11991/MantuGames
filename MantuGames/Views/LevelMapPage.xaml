<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.LevelMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    x:Name="PageRoot"
    BackgroundColor="{StaticResource ColorBg}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Back + Points + Rules -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8,44,12,0">
            <ImageButton Grid.Column="0"
                    Source="icon_back_round"
                    HeightRequest="48" WidthRequest="48"
                    BackgroundColor="Transparent" Padding="0"
                    Clicked="OnBackClicked"
                    VerticalOptions="Center" />

            <Border Grid.Column="1"
                    BackgroundColor="#26182136"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label x:Name="PointsLabel"
                       Text="0 pts"
                       FontFamily="Orbitron"
                       FontSize="13"
                       TextColor="#FF9F1C"
                       Padding="14,6" />
            </Border>

            <ImageButton Grid.Column="2"
                         Source="info.svg"
                         HeightRequest="24" WidthRequest="24"
                         BackgroundColor="Transparent" Padding="0"
                         Margin="10,0,0,0"
                         Clicked="OnRulesClicked"
                         VerticalOptions="Center" />
        </Grid>

        <!-- Row 1: Game name + SELECT LEVEL -->
        <StackLayout Grid.Row="1"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Spacing="2"
                     Margin="0,10,0,4">
            <Label x:Name="GameTitleLabel"
                   FontFamily="Inter"
                   FontSize="14"
                   TextColor="#9AA7BD"
                   Opacity="0.7"
                   HorizontalOptions="Center" />
            <Label Text="Select Level"
                   FontFamily="Orbitron"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#E7ECF5"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Row 2: Level grid -->
        <CollectionView Grid.Row="2"
                        x:Name="LevelCollectionView"
                        ItemsSource="{Binding Levels}"
                        SelectionMode="None"
                        Margin="14,4,14,24"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="5"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource PanelCard}"
                           Padding="0"
                           BackgroundColor="Transparent"
                           HasShadow="False"
                           BorderColor="Transparent"
                           CornerRadius="18"
                           HeightRequest="82"
                           WidthRequest="82">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LevelTappedCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Grid Grid.Row="0"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  WidthRequest="74"
                                  HeightRequest="74">
                                <Border x:Name="LevelBg"
                                        BackgroundColor="{Binding BgColor}"
                                        Stroke="{Binding StrokeColor}"
                                        StrokeThickness="2"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="{Binding ShadowBrush}"
                                            Offset="0,4"
                                            Radius="8"
                                            Opacity="0.45" />
                                    </Border.Shadow>
                                </Border>
                                <Border BackgroundColor="{Binding FaceColor}"
                                        StrokeThickness="0"
                                        Opacity="{Binding FaceOpacity}"
                                        Margin="5"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                </Border>
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding LevelText}"
                                           FontFamily="Orbitron"
                                           FontSize="34"
                                           FontAttributes="Bold"
                                           TextColor="#160D02"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding ShowNumber}" />
                                    <Image Source="lock"
                                           HeightRequest="34"
                                           WidthRequest="34"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding ShowLock}" />
                                </Grid>
                            </Grid>
                            <HorizontalStackLayout Grid.Row="1"
                                                   HorizontalOptions="Center"
                                                   Spacing="1"
                                                   IsVisible="{Binding ShowStars}">
                                <Image Source="star_kawaii_filled.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       Opacity="1" IsVisible="{Binding Star1}" />
                                <Image Source="star_kawaii_filled.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       Opacity="1" IsVisible="{Binding Star2}" />
                                <Image Source="star_kawaii_filled.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       Opacity="1" IsVisible="{Binding Star3}" />
                                <Image Source="star_kawaii_empty.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       Opacity="0.45" IsVisible="{Binding Star4}" />
                                <Image Source="star_kawaii_empty.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       Opacity="0.45" IsVisible="{Binding Star5}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:RulesPopup x:Name="RulesPopup" IsVisible="False"
            Grid.RowSpan="3"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </Grid>
</ContentPage>