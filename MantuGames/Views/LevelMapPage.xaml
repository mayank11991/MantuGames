<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.LevelMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    x:Name="PageRoot"
    BackgroundColor="{StaticResource PopPaper}">

    <Grid>
        <controls:ClayBackground x:Name="Backdrop" Variant="Accent" />

        <CollectionView x:Name="LevelCollectionView"
                        ItemsSource="{Binding Levels}"
                        SelectionMode="None"
                        Margin="14,0">
            <CollectionView.Header>
                <VerticalStackLayout Padding="6,14,6,8" Spacing="0">

                    <!-- Top bar: back · coins -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Style="{StaticResource CtaCircleBlue}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked" />
                            </Border.GestureRecognizers>
                            <Image Source="ic_back_white.png" WidthRequest="24" HeightRequest="24" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PopPillDark}" Padding="12,8,16,8" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="coin.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label x:Name="CoinsLabel" Text="0" FontFamily="Baloo2ExtraBold" FontSize="15"
                                       TextColor="#FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Hero: big title + tilted game art -->
                    <Grid Margin="0,16,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                            <Label x:Name="GameTitleLabel" Style="{StaticResource PopHero}" FontSize="50"
                                   LineBreakMode="WordWrap" MaxLines="3" />
                            <Border Style="{StaticResource PopPillDark}" Padding="12,6" HorizontalOptions="Start">
                                <HorizontalStackLayout Spacing="10">
                                    <Label x:Name="ProgressLabel" Text="0 / 50" FontFamily="Baloo2ExtraBold" FontSize="13"
                                           TextColor="#FFFFFF" VerticalOptions="Center" />
                                    <BoxView WidthRequest="1.5" HeightRequest="14" Color="#55FFFFFF" VerticalOptions="Center" />
                                    <Image Source="star_kawaii_filled.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                    <Label x:Name="StarsLabel" Text="0" FontFamily="Baloo2ExtraBold" FontSize="13"
                                           TextColor="#FFFFFF" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="124" HeightRequest="165" Padding="0"
                                BackgroundColor="{StaticResource PopPaper}"
                                Stroke="{StaticResource PopInk}" StrokeThickness="3" Rotation="5"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="6,8" Radius="0" Opacity="0.9" />
                            </Border.Shadow>
                            <Image x:Name="HeroThumb" Aspect="AspectFill" />
                        </Border>
                    </Grid>

                    <!-- How to play -->
                    <Border Style="{StaticResource PopCard}" Margin="0,22,0,0" Padding="16,14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource CtaCircleYellow}"
                                    WidthRequest="42" HeightRequest="42" VerticalOptions="Start">
                                <Image Source="ic_bulb_white.png" WidthRequest="22" HeightRequest="22" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="How to play" FontFamily="Baloo2ExtraBold" FontSize="16" />
                                <Label x:Name="InstructionsLabel" Style="{StaticResource PopBody}" FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Label Text="Levels" Style="{StaticResource PopSection}" Margin="2,22,0,4" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="5"
                                 HorizontalItemSpacing="6" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="3" Padding="0,4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LevelTappedCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{Binding BgColor}"
                                Stroke="{Binding StrokeColor}"
                                StrokeThickness="2.5"
                                Opacity="{Binding FaceOpacity}"
                                WidthRequest="58" HeightRequest="58"
                                HorizontalOptions="Center"
                                Content="{Binding FaceContent}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{Binding ShadowBrush}" Offset="0,5" Radius="0" Opacity="1" />
                            </Border.Shadow>
                        </Border>
                        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="1"
                                               IsVisible="{Binding ShowStars}">
                            <Image Source="{Binding Star1Icon}" WidthRequest="13" HeightRequest="13" />
                            <Image Source="{Binding Star2Icon}" WidthRequest="13" HeightRequest="13" />
                            <Image Source="{Binding Star3Icon}" WidthRequest="13" HeightRequest="13" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <controls:RulesPopup x:Name="RulesPopup" IsVisible="False" />
    </Grid>
</ContentPage>
