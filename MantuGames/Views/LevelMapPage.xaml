<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.LevelMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    x:Name="PageRoot">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Row 0: Back + Points -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="8,44,12,0">
            <ImageButton Grid.Column="0"
                    Source="icon_back_round"
                    HeightRequest="48" WidthRequest="48"
                    BackgroundColor="Transparent" Padding="0"
                    Clicked="OnBackClicked"
                    VerticalOptions="Center" />

            <Border Grid.Column="2"
                    BackgroundColor="#335A5670"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label x:Name="PointsLabel"
                       Text="⭐ 0 pts"
                       FontFamily="BrickSans"
                       FontSize="13"
                       TextColor="#D4B896"
                       Padding="14,6" />
            </Border>
        </Grid>

        <!-- Row 1: Game name + SELECT LEVEL -->
        <StackLayout Grid.Row="1"
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                     Spacing="2"
                     Margin="0,10,0,4">
            <Label x:Name="GameTitleLabel"
                   FontFamily="BrickSans"
                   FontSize="14"
                   TextColor="#F0E6D8"
                   Opacity="0.7"
                   HorizontalOptions="Center" />
            <Label Text="Select Level"
                   FontFamily="BrickSans"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#F0E6D8"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Row 2: Level grid -->
        <ScrollView Grid.Row="2" Padding="14,4,14,24">
            <FlexLayout x:Name="LevelGrid"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Start"
                        AlignContent="Start" />
        </ScrollView>

    </Grid>
</ContentPage>
