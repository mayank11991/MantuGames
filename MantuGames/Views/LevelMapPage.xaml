<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.LevelMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    x:Name="PageRoot"
    BackgroundColor="{StaticResource ColorBg}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Nebula background effect -->
        <Grid x:Name="NebulaContainer" Grid.RowSpan="3" InputTransparent="True">
            <Grid.Opacity>0.5</Grid.Opacity>
            <Grid>
                <Ellipse x:Name="Nebula1"
                         WidthRequest="520" HeightRequest="520"
                         HorizontalOptions="End" VerticalOptions="Start"
                         Margin="-120,-120,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#AA55F7" />
                            <GradientStop Offset="0.65" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="Nebula2"
                         WidthRequest="460" HeightRequest="460"
                         HorizontalOptions="Start" VerticalOptions="End"
                         Margin="-160,0,0,-160">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#22D3EE" />
                            <GradientStop Offset="0.65" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="Nebula3"
                         WidthRequest="340" HeightRequest="340"
                         HorizontalOptions="Center" VerticalOptions="Center"
                         Margin="0,0,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#FF9F1C" />
                            <GradientStop Offset="0.65" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <!-- Row 0: Header - Back | Title | Coins -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,48,16,8">
            <ImageButton Grid.Column="0"
                    Source="icon_back_round"
                    HeightRequest="40" WidthRequest="40"
                    BackgroundColor="Transparent" Padding="0"
                    Clicked="OnBackClicked"
                    VerticalOptions="Center" />

            <Label x:Name="GameTitleLabel"
                   Grid.Column="1"
                   FontFamily="MomoTrustDisplay"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource ColorText}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <!-- Coins (right of title) -->
            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="6"
                                   VerticalOptions="Center">
                <Image Source="coin.png"
                       WidthRequest="22" HeightRequest="22" />
                <Label x:Name="CoinsLabel"
                       FontFamily="MomoTrustDisplay"
                       FontSize="22"
                       TextColor="#FF9F1C"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Row 1: Instructions (center-aligned) -->
        <Border Grid.Row="1" 
                BackgroundColor="Transparent"
                StrokeThickness="0"
                Padding="20,12,20,8">
            <Label x:Name="InstructionsLabel"
                   FontFamily="MomoTrustDisplay"
                   FontSize="20"
                   TextColor="{StaticResource ColorText}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Border>

        <!-- Row 2: Level grid -->
        <Border Grid.Row="2"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>

            <!-- Level Grid (scrollable) -->
            <CollectionView Grid.Row="2"
                            x:Name="LevelCollectionView"
                            ItemsSource="{Binding Levels}"
                            SelectionMode="None"
                            Margin="16,24,16,24"
                            VerticalOptions="Fill">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="5"
                                     HorizontalItemSpacing="8"
                                     VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="Transparent"
                                Padding="0"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LevelTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Border x:Name="LevelBg"
                                        BackgroundColor="{Binding BgColor}"
                                        Stroke="{Binding StrokeColor}"
                                        StrokeThickness="2"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        WidthRequest="56"
                                        HeightRequest="56">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="{Binding ShadowBrush}"
                                            Offset="0,4"
                                            Radius="8"
                                            Opacity="0.45" />
                                    </Border.Shadow>
                                    <Border Content="{Binding FaceContent}"
                                            BackgroundColor="{Binding FaceColor}"
                                            StrokeThickness="0"
                                            Opacity="{Binding FaceOpacity}"
                                            Margin="3"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                    </Border>
                                </Border>
                                <HorizontalStackLayout Grid.Row="1"
                                                       HorizontalOptions="Center"
                                                       Spacing="2"
                                                       IsVisible="{Binding ShowStars}">
                                    <Image Source="star_kawaii_filled.svg"
                                           WidthRequest="12" HeightRequest="12"
                                           Opacity="1" IsVisible="{Binding Star1}" />
                                    <Image Source="star_kawaii_filled.svg"
                                           WidthRequest="12" HeightRequest="12"
                                           Opacity="1" IsVisible="{Binding Star2}" />
                                    <Image Source="star_kawaii_filled.svg"
                                           WidthRequest="12" HeightRequest="12"
                                           Opacity="1" IsVisible="{Binding Star3}" />
                                    <Image Source="star_kawaii_empty.svg"
                                           WidthRequest="12" HeightRequest="12"
                                           Opacity="0.45" IsVisible="{Binding Star4}" />
                                    <Image Source="star_kawaii_empty.svg"
                                           WidthRequest="12" HeightRequest="12"
                                           Opacity="0.45" IsVisible="{Binding Star5}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Border>

        <controls:RulesPopup x:Name="RulesPopup" IsVisible="False"
            Grid.RowSpan="3"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </Grid>
</ContentPage>
