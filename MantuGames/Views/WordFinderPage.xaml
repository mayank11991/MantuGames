<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.WordFinderPage"
>
    <AbsoluteLayout>
        <controls:ClayBackground AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Frame Grid.Column="0" BackgroundColor="#FFFDFA" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="#FFFDFA" CornerRadius="20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#9B7BFF"
                           FontSize="16" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                </Frame>
                <Frame Grid.Column="2" BackgroundColor="#FFFDFA" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Frame>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="WordFinderTimer" Grid.Row="2"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- LETTER GRID centered -->
            <Border Grid.Row="3"
                    BackgroundColor="#668A6FA8"
                    Padding="6"
                    StrokeThickness="2" Stroke="#D8CAE8"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid x:Name="LetterGrid" ColumnSpacing="2" RowSpacing="2" />
            </Border>

            <!-- WORD LIST -->
            <Frame Grid.Row="4"
                   BackgroundColor="#668A6FA8" CornerRadius="16"
                   Padding="10,8" HasShadow="True"
                   HorizontalOptions="Fill">
                <StackLayout Spacing="4">
                    <Label Text="Find these words:" FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                           TextColor="#9B7BFF" HorizontalOptions="Center" />
                    <CollectionView ItemsSource="{Binding Words}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="6,4" CornerRadius="8"
                                       BackgroundColor="#F4E9FF"
                                       HorizontalOptions="Fill"
                                       Margin="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding DisplayWord}"
                                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                                               HorizontalOptions="Start"
                                               HorizontalTextAlignment="Start"
                                               TextColor="#3D2C4E" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="✓"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#2F9E7F"
                                               VerticalOptions="Center"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding IsFound}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="5" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionCoinLabel"
                       
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#3D2C4E" BackgroundColor="#FFA94D"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolutionClicked" />
                <!-- <Label x:Name="SolutionCoinLabel" -->
                <!--        FontFamily="MadimiOne" -->
                <!--        FontSize="11" -->
                <!--        TextColor="#D9A400" -->
                <!--        HorizontalOptions="Center" /> -->
            </VerticalStackLayout>
        </Grid>

        <!-- WIN/LOSS POPUP -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
