<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.WordFinderPage"
>
    <AbsoluteLayout>
        <Image Source="app_bg.png" Aspect="AspectFill"
               AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" />
        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Frame Grid.Column="0" BackgroundColor="#182136" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="#182136" CornerRadius="20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#A855F7"
                           FontSize="16" FontFamily="MomoTrustDisplay" FontAttributes="Bold" HorizontalOptions="Center" />
                </Frame>
                <Frame Grid.Column="2" BackgroundColor="#182136" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Frame>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="WordFinderTimer" Grid.Row="2"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- LETTER GRID centered -->
            <Border Grid.Row="3"
                    BackgroundColor="#182136"
                    Padding="6"
                    StrokeThickness="2" Stroke="#2E3A5F"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid x:Name="LetterGrid" ColumnSpacing="2" RowSpacing="2" />
            </Border>

            <!-- WORD LIST -->
            <Frame Grid.Row="4"
                   BackgroundColor="#182136" CornerRadius="16"
                   Padding="10,8" HasShadow="True"
                   HorizontalOptions="Fill">
                <StackLayout Spacing="4">
                    <Label Text="Find these words:" FontSize="13" FontFamily="MomoTrustDisplay" FontAttributes="Bold"
                           TextColor="#A855F7" HorizontalOptions="Center" />
                    <CollectionView ItemsSource="{Binding Words}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="6,4" CornerRadius="8"
                                       BackgroundColor="#1E293B"
                                       HorizontalOptions="Fill"
                                       Margin="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding DisplayWord}"
                                               FontSize="13" FontFamily="MomoTrustDisplay" FontAttributes="Bold"
                                               HorizontalOptions="Start"
                                               HorizontalTextAlignment="Start"
                                               TextColor="#E7ECF5" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="✓"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#4CAF50"
                                               VerticalOptions="Center"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding IsFound}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="5" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionButton"
                        Text="💡 Show Solution"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#1E1B4B" BackgroundColor="#F5A623"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolutionClicked" />
                <Label x:Name="SolutionCoinLabel"
                       FontFamily="MomoTrustDisplay"
                       FontSize="11"
                       TextColor="#DBD748"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- WIN/LOSS POPUP -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
