<?xml version="1.0" encoding="utf-8"?>
<ContentPage BackgroundColor="{StaticResource NightBg}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.WordFinderPage"
>
    <AbsoluteLayout>
        <controls:ClayBackground Variant="Night" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Style="{StaticResource NightCircle}" Grid.Column="0"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_back_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <controls:ThinkingBuddy Grid.Column="1" Text="{Binding LevelDisplay}" />
                <Border Style="{StaticResource CtaCircleOrange}" Grid.Column="2"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_pause_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView x:Name="WordFinderTimer" Grid.Row="2"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- LETTER GRID centered -->
            <Border Grid.Row="3"
                    BackgroundColor="#F2FFFFFF"
                    Padding="6"
                    StrokeThickness="2" Stroke="#D6E4F0"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid x:Name="LetterGrid" ColumnSpacing="2" RowSpacing="2" />
            </Border>

            <!-- WORD LIST -->
            <Border Style="{StaticResource ClayFrame}" Grid.Row="4"
                   BackgroundColor="#F2FFFFFF" StrokeShape="RoundRectangle 16"
                   Padding="10,8"
                   HorizontalOptions="Fill">
                <StackLayout Spacing="4">
                    <Label Text="Find these words:" FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                           TextColor="#1F2A44" HorizontalOptions="Center" />
                    <CollectionView ItemsSource="{Binding Words}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClayFrame}" Padding="6,4" StrokeShape="RoundRectangle 8"
                                       BackgroundColor="#FFFFFF"
                                       HorizontalOptions="Fill"
                                       Margin="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding DisplayWord}"
                                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                                               HorizontalOptions="Start"
                                               HorizontalTextAlignment="Start"
                                               TextColor="#1F2A44" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="✓"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#35D49A"
                                               VerticalOptions="Center"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding IsFound}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Border>

            <!-- SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="5" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionCoinLabel" Style="{StaticResource CtaButtonYellow}"
                       
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#111114" BackgroundColor="#FFC83D"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolutionClicked" />
                <!-- <Label x:Name="SolutionCoinLabel" -->
                <!--        FontFamily="MadimiOne" -->
                <!--        FontSize="11" -->
                <!--        TextColor="#D9A400" -->
                <!--        HorizontalOptions="Center" /> -->
            </VerticalStackLayout>
        </Grid>

        <!-- WIN/LOSS POPUP -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
