<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.PuzzlePetsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
    >
    <ContentPage.BackgroundColor>
        <AppThemeBinding Light="#FBF4ED" Dark="#1F1B1B" />
    </ContentPage.BackgroundColor>

    <AbsoluteLayout x:Name="RootLayout">

        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="4"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- Row 0: Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <ImageButton Grid.Column="0"
                             Source="icon_back_round.svg"
                             Padding="0" HeightRequest="48" WidthRequest="48"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"
                             VerticalOptions="Center" />
                <Frame Grid.Column="1"
                       BackgroundColor="#C4A4D4" CornerRadius="20"
                       Padding="12,6" HasShadow="False"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="LevelLabel" Text="Level 1"
                           FontSize="16" FontFamily="BrickSans" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" />
                </Frame>
                <Border Grid.Column="2"
                        BackgroundColor="#33000000"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label x:Name="TimerLabel"
                           Text="⏱ 1:20"
                           FontFamily="BrickSans"
                           FontSize="13"
                           TextColor="White"
                           Padding="12,6" />
                </Border>
                <ImageButton Grid.Column="3" Source="information.png"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="0,0,4,0"
                             Clicked="OnRulesClicked"
                             VerticalOptions="Center" />
                <ImageButton Grid.Column="4" Source="pause.png"
                             HeightRequest="24" WidthRequest="24"
                             BackgroundColor="Transparent" Padding="0"
                             Margin="4,0"
                             Clicked="OnPause"
                             VerticalOptions="Center" />
            </Grid>

            <!-- Row 1: Animal reference -->
            <Border Grid.Row="1"
                   
                    StrokeThickness="0"
                    Padding="12,8"
                    HorizontalOptions="Center"
                    Margin="8,2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <ProgressBar 
                             x:Name="TimerBar"
                             Progress="1"
                             ProgressColor="#C4A4D4"
                             Margin="14,0,14,4" />
            </Border>

            <!-- Row 2: Timer progress bar -->

            <!-- Row 3: Puzzle grid -->
            <ScrollView Grid.Row="3" Orientation="Vertical" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Border 
                            StrokeThickness="0"
                            Padding="6"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid x:Name="PuzzleGrid"
                              ColumnSpacing="4" RowSpacing="4"
                              HorizontalOptions="Center" />
                    </Border>

                    <!-- Status label between grid and tray -->
                    <Label x:Name="StatusLabel"
                           Text="Drag a piece to its spot!" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           FontFamily="BrickSans"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#C4A4D4"/>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Row 4: Piece tray -->
            <Border Grid.Row="4"
                     
                    StrokeThickness="0"
                    Padding="8,8"
                    Margin="8,2,8,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="PieceTray"
                                           Spacing="10"
                                           Padding="4,4" />
                </ScrollView>
            </Border>

            <!-- Row 5: Solution button -->
            <Button Grid.Row="5"
                    x:Name="SolutionButton"
                    Text="💡 Show Solution"
                    FontSize="13" FontAttributes="Bold"
                    TextColor="White" BackgroundColor="#7C4DFF"
                    CornerRadius="20" HeightRequest="40"
                    Margin="50,0,50,4"
                    Clicked="OnShowSolution" />
        </Grid>

        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:RulesPopup x:Name="RulesPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
