<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="MantuGames.Views.PuzzlePetsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False"
>

    <AbsoluteLayout x:Name="RootLayout">
        <Image Source="app_bg.png" Aspect="AspectFill"
               AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" />
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="4"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- Row 0: Top bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Frame Grid.Column="0" BackgroundColor="#182136" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="#182136" CornerRadius="20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="LevelLabel" Text="Level 1"
                           FontSize="16" FontFamily="MomoTrustDisplay" FontAttributes="Bold"
                           TextColor="#F472B6" HorizontalOptions="Center" />
                </Frame>
                <Frame Grid.Column="2" BackgroundColor="#182136" CornerRadius="24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Frame>
            </Grid>

            <!-- Row 1: Timer -->
            <controls:GameTimerView x:Name="PuzzleTimer" Grid.Row="1" />

            <!-- Row 2: Puzzle grid -->
            <ScrollView Grid.Row="2" Orientation="Vertical" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Border StrokeThickness="2" Stroke="#2E3A5F"
                            Padding="6" BackgroundColor="#0F1420"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid x:Name="PuzzleGrid"
                              ColumnSpacing="4" RowSpacing="4"
                              HorizontalOptions="Center" />
                    </Border>

                    <Label x:Name="StatusLabel"
                           Text="Drag pieces from the tray to their spots!" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           FontFamily="MomoTrustDisplay"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#F472B6"/>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Row 3: Piece tray -->
            <Border Grid.Row="3"
                    BackgroundColor="#182136" StrokeThickness="0"
                    Padding="8,8" Margin="8,2,8,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Grid x:Name="PieceTrayGrid"
                      ColumnSpacing="8" RowSpacing="8"
                      Padding="4,4"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Border>

            <!-- Row 4: Show Solution -->
            <VerticalStackLayout Grid.Row="4" Spacing="2" Margin="50,0,50,4">
                <Button x:Name="SolutionButton"
                        Text="💡 Show Solution"
                        FontSize="14" FontAttributes="Bold"
                        TextColor="#1E1B4B" BackgroundColor="#F5A623"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolution" />
                <Label x:Name="SolutionCoinLabel"
                       FontFamily="MomoTrustDisplay"
                       FontSize="11"
                       TextColor="#DBD748"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
