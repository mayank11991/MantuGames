<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MantuGames.Views.DashboardPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:MantuGames.Converters"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    BackgroundColor="{StaticResource ColorBg}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringToColorConverter x:Key="StringToColor" />
    </ContentPage.Resources>

    <!-- Clay background is drawn by ClayBackground; page stays soft lavender. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Soft clay background -->
        <controls:ClayBackground AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />

        <!-- ── HEADER ── -->
        <Grid Grid.Row="0" Padding="18,8,18,4"
              RowDefinitions="Auto,Auto,Auto">

            <!-- Utility row: profile avatar + coin balance -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        BackgroundColor="#FFFFFF"
                        Stroke="#80FFFFFF"
                        StrokeThickness="1"
                        Padding="3,3,12,3"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#8A6FA8" Offset="0,2" Radius="5" Opacity="0.18" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSwitchProfile" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Border WidthRequest="30" HeightRequest="30"
                                BackgroundColor="#E9DEFF"
                                Stroke="#FFFFFF"
                                StrokeThickness="2"
                                Padding="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Image x:Name="HeaderAvatar"
                                   Source="a1.png"
                                   Aspect="AspectFit"
                                   WidthRequest="26" HeightRequest="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="HeaderPlayerName"
                               Text="Player"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#3D2C4E"
                               MaximumWidthRequest="120"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="#FFFFFF"
                        Stroke="#80FFFFFF"
                        StrokeThickness="1"
                        Padding="10,5"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#8A6FA8" Offset="0,2" Radius="5" Opacity="0.15" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCoinShopClicked" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                        <Image Source="coin.png"
                               WidthRequest="18" HeightRequest="18"
                               VerticalOptions="Center" />
                        <Label x:Name="CoinBalanceLabel"
                               Text="0"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#3D2C4E"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Clay title -->
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <Label Text="Mantu Games"
                       FontFamily="Baloo2ExtraBold"
                       FontSize="40"
                       CharacterSpacing="0.5"
                       TextColor="#3D2C4E"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center">
                    <Label.Shadow>
                        <Shadow Brush="#FFFFFF" Offset="0,3" Radius="2" Opacity="0.9" />
                    </Label.Shadow>
                </Label>
            </Grid>

            <Label Grid.Row="2"
                   Text="Play  •  Learn  •  Explore"
                   FontFamily="MadimiOne"
                   FontSize="12"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextColor="#7C6A8E"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,2" />
        </Grid>

        <!-- ── GAME GRID ── -->
        <ScrollView x:Name="GamesScroll"
                    Grid.Row="1"
                    Margin="14,6,14,4"
                    VerticalOptions="Fill">
            <VerticalStackLayout x:Name="GamesFlex"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,8" />
        </ScrollView>

        <!-- ── BOTTOM NAVIGATION ── -->
        <Border Grid.Row="2"
                Margin="16,0,16,10"
                BackgroundColor="#FFFFFF"
                Stroke="#40FFFFFF"
                StrokeThickness="1"
                Padding="6,6">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#8A6FA8" Offset="0,4" Radius="14" Opacity="0.20" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- Home (active) -->
                <VerticalStackLayout Grid.Column="0" Spacing="1"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavHomeClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="#E9DEFF"
                            StrokeThickness="0"
                            WidthRequest="50" HeightRequest="30"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Label Text="🏠" FontSize="15"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Home" FontFamily="MadimiOne" FontSize="10"
                           FontAttributes="Bold" TextColor="#5B3FD1"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Stats -->
                <VerticalStackLayout Grid.Column="1" Spacing="1"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavStatsClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            WidthRequest="50" HeightRequest="30"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Label Text="🏆" FontSize="15"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Stats" FontFamily="MadimiOne" FontSize="10"
                           FontAttributes="Bold" TextColor="#7C6A8E"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Settings -->
                <VerticalStackLayout Grid.Column="2" Spacing="1"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavSettingsClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            WidthRequest="50" HeightRequest="30"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Label Text="⚙️" FontSize="15"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Settings" FontFamily="MadimiOne" FontSize="10"
                           FontAttributes="Bold" TextColor="#7C6A8E"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" Spacing="1"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavProfileClicked" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            WidthRequest="50" HeightRequest="30"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Label Text="👤" FontSize="15"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Profile" FontFamily="MadimiOne" FontSize="10"
                           FontAttributes="Bold" TextColor="#7C6A8E"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <controls:SettingsPopup x:Name="SettingsPopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:ProfilePopup x:Name="ProfilePopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:ProfilePickerPopup x:Name="ProfilePicker" IsVisible="False" Grid.RowSpan="3" />
        <controls:EditProfilePopup x:Name="EditProfilePopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:StatsPopup x:Name="StatsPopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:UpdatePopup x:Name="UpdatePopup" IsVisible="False" Grid.RowSpan="3" />

    </Grid>
</ContentPage>
