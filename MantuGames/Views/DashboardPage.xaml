<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MantuGames.Views.DashboardPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:MantuGames.Converters"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    BackgroundColor="{StaticResource PopPaper}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringToColorConverter x:Key="StringToColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <controls:ClayBackground Grid.RowSpan="2" Variant="Lime" />

        <!-- ── SCROLLING CONTENT ── -->
        <ScrollView x:Name="GamesScroll" Grid.Row="0">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="0">

                <!-- Top bar: avatar · coins · settings -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource PopCircleSoft}"
                            WidthRequest="54" HeightRequest="54" BackgroundColor="{StaticResource PopPaper}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSwitchProfile" />
                        </Border.GestureRecognizers>
                        <Image x:Name="HeaderAvatar" Source="a1.png" Aspect="AspectFill"
                               WidthRequest="48" HeightRequest="48">
                            <Image.Clip>
                                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                            </Image.Clip>
                        </Image>
                    </Border>

                    <!-- Coin balance pill -->
                    <Border Grid.Column="2" Style="{StaticResource PopPillDark}"
                            Padding="12,8,16,8" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCoinShopClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="coin.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="CoinBalanceLabel" Text="0"
                                   FontFamily="Baloo2ExtraBold" FontSize="15"
                                   TextColor="#FFFFFF" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CtaCircleBlue}" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="ic_gear_white.png" WidthRequest="24" HeightRequest="24" />
                    </Border>
                </Grid>

                <!-- Hero: WELCOME! + player name -->
                <VerticalStackLayout Margin="0,18,0,0" Spacing="0">
                    <controls:FitLabel Text="WELCOME!"
                           Style="{StaticResource PopHero}"
                           FontSize="76"
                           HorizontalOptions="Start"
                           VerticalOptions="Start" />
                    <VerticalStackLayout HorizontalOptions="Start" Spacing="0" Margin="2,0,0,0">
                        <Label Text="Hey" Style="{StaticResource PopBody}" FontSize="16" />
                        <controls:FitLabel x:Name="HeaderPlayerName" Text="Player"
                               FontFamily="Baloo2ExtraBold" FontSize="26"
                               />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Stats strip: progress only. Coins live in the wallet pill above;
                     stars are per game and shown on each game's level screen. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,18,0,0">
                    <Border Grid.Column="0" Style="{StaticResource PopCard}" Padding="12,10">
                        <VerticalStackLayout Spacing="-4" HorizontalOptions="Center">
                            <controls:FitLabel x:Name="LevelsStat" Text="0" FontFamily="Display" FontSize="22" HorizontalOptions="Center" />
                            <Label Text="levels done" Style="{StaticResource PopMutedLabel}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PopCard}" Padding="12,10">
                        <VerticalStackLayout Spacing="-4" HorizontalOptions="Center">
                            <controls:FitLabel x:Name="WinsStat" Text="0" FontFamily="Display" FontSize="22" HorizontalOptions="Center" />
                            <Label Text="games won" Style="{StaticResource PopMutedLabel}" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Daily challenge: today's featured game + streak (filled in code-behind) -->
                <Border x:Name="DailyCard" Style="{StaticResource PopCard}"
                        BackgroundColor="#FFE0C2" Padding="12" Margin="0,14,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDailyTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border x:Name="DailyThumb" StrokeThickness="0" WidthRequest="60" HeightRequest="80"
                                BackgroundColor="#5AA6FF" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Image x:Name="DailyImage" Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="-2" VerticalOptions="Center">
                            <Label Text="DAILY CHALLENGE" FontFamily="Baloo2ExtraBold" FontSize="12"
                                   TextColor="#D4611A" CharacterSpacing="1" />
                            <controls:FitLabel x:Name="DailyTitle" MinFontSize="12"
                                   FontFamily="Baloo2ExtraBold" FontSize="18" TextColor="#111114"
                                   MaxLines="2" />
                            <Label x:Name="DailySub" FontFamily="Baloo2Medium" FontSize="13"
                                   TextColor="#3A3A46" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2" Style="{StaticResource PopPillDark}"
                                Padding="12,6" MinimumWidthRequest="64" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="0">
                                <Label x:Name="StreakLabel" Text="🔥 0" FontFamily="Baloo2ExtraBold" FontSize="16"
                                       TextColor="#FFFFFF" HorizontalOptions="Center" />
                                <Label Text="streak" FontFamily="Baloo2Medium" FontSize="11"
                                       TextColor="#CFD2DC" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Section title + search -->
                <Label Text="Pick your game" Style="{StaticResource PopSection}" FontSize="26" Margin="2,22,0,10" />
                <Border BackgroundColor="#F2FFFFFF" StrokeThickness="0" Padding="16,2,16,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource PopShadow}" Offset="0,4" Radius="12" Opacity="0.10" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image Source="ic_search_ink.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Entry Grid.Column="1" x:Name="SearchEntry"
                               Placeholder="Search a game"
                               PlaceholderColor="{StaticResource PopMuted}"
                               TextColor="{StaticResource PopInk}"
                               BackgroundColor="Transparent"
                               FontFamily="Baloo2Medium" FontSize="15"
                               TextChanged="OnSearchTextChanged" />
                    </Grid>
                </Border>

                <!-- Game cards (built in code-behind, 2 columns) -->
                <VerticalStackLayout x:Name="GamesFlex" Spacing="14" Margin="0,18,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── BOTTOM NAVIGATION: ( home | stats )  [ games ]  ( settings | profile ) ── -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Padding="16,10,16,10" ColumnSpacing="16">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00FFFFFF" />
                    <GradientStop Offset="0.45" Color="#F2FFFFFF" />
                </LinearGradientBrush>
            </Grid.Background>

            <HorizontalStackLayout Grid.Column="0" Spacing="10" HorizontalOptions="End" Padding="0,0,0,8">
                    <Border Style="{StaticResource CtaCircleGreen}" WidthRequest="50" HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavHomeClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="ic_home_white.png" WidthRequest="24" HeightRequest="24" />
                    </Border>
                    <Border Style="{StaticResource CtaCircleYellow}" WidthRequest="50" HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavStatsClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="ic_trophy_white.png" WidthRequest="24" HeightRequest="24" />
                    </Border>
                </HorizontalStackLayout>

            <Border Grid.Column="1" Style="{StaticResource CtaCircleOrange}"
                    WidthRequest="66" HeightRequest="66" StrokeThickness="4" Margin="0,0,0,6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNavHomeClicked" />
                </Border.GestureRecognizers>
                <Image Source="ic_grid_white.png" WidthRequest="30" HeightRequest="30" />
            </Border>

            <HorizontalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="Start" Padding="0,0,0,8">
                    <Border Style="{StaticResource CtaCircleBlue}" WidthRequest="50" HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavSettingsClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="ic_gear_white.png" WidthRequest="24" HeightRequest="24" />
                    </Border>
                    <Border Style="{StaticResource CtaCirclePink}" WidthRequest="50" HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavProfileClicked" />
                        </Border.GestureRecognizers>
                        <Image Source="ic_user_white.png" WidthRequest="24" HeightRequest="24" />
                    </Border>
                </HorizontalStackLayout>
        </Grid>

        <controls:SettingsPopup x:Name="SettingsPopup" IsVisible="False" Grid.RowSpan="2" />
        <controls:ProfilePopup x:Name="ProfilePopup" IsVisible="False" Grid.RowSpan="2" />
        <controls:ProfilePickerPopup x:Name="ProfilePicker" IsVisible="False" Grid.RowSpan="2" />
        <controls:EditProfilePopup x:Name="EditProfilePopup" IsVisible="False" Grid.RowSpan="2" />
        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False" Grid.RowSpan="2" />
        <controls:StatsPopup x:Name="StatsPopup" IsVisible="False" Grid.RowSpan="2" />
        <controls:UpdatePopup x:Name="UpdatePopup" IsVisible="False" Grid.RowSpan="2" />
        <controls:AgeGatePopup x:Name="AgeGate" IsVisible="False" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
