<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="MantuGames.Views.DashboardPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:MantuGames.Converters"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    BackgroundColor="{StaticResource ColorBg}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringToColorConverter x:Key="StringToColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Nebula background effect (similar to website) -->
        <Grid x:Name="NebulaContainer" Grid.RowSpan="3" InputTransparent="True">
            <Grid.Opacity>0.5</Grid.Opacity>
            <Grid>
                <Ellipse x:Name="Nebula1"
                         WidthRequest="520" HeightRequest="520"
                         HorizontalOptions="End" VerticalOptions="Start"
                         Margin="-120,-120,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#AA55F7" />
                            <GradientStop Offset="0.65" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="Nebula2"
                         WidthRequest="460" HeightRequest="460"
                         HorizontalOptions="Start" VerticalOptions="End"
                         Margin="-160,0,0,-160">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#22D3EE" />
                            <GradientStop Offset="0.65" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="Nebula3"
                         WidthRequest="340" HeightRequest="340"
                         HorizontalOptions="Center" VerticalOptions="Center"
                         Margin="0,0,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#FF9F1C" />
                            <GradientStop Offset="0.65" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>

        <!-- ── TOP BAR ── -->
        <Grid Grid.Row="0" Padding="20,14,20,6" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <Label x:Name="PlayerNameLabel"
                   Grid.Column="0"
                   FontFamily="MomoTrustDisplay"
                   FontSize="15"
                   CharacterSpacing="1"
                   TextColor="{StaticResource ColorText}"
                   VerticalOptions="Center" />
            <Label x:Name="PointsLabel"
                   Grid.Column="1"
                   FontFamily="MomoTrustDisplay"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource ColorCta}"
                   VerticalOptions="Center"
                   Margin="0,0,10,0" />
            <Label x:Name="CoinBalanceLabel"
                   Grid.Column="2"
                   FontFamily="MomoTrustDisplay"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource ColorAccent}"
                   VerticalOptions="Center"
                   Margin="0,0,8,0" />
            <ImageButton Grid.Column="3"
                         HeightRequest="20" WidthRequest="20"
                         Source="coin.png" Scale="0.7"
                         BackgroundColor="Transparent" Padding="0"
                         Margin="0,0,10,0"
                         SemanticProperties.Description="Coin shop"
                         Clicked="OnCoinShopClicked"
                         VerticalOptions="Center" />
            <ImageButton Grid.Column="4"
                         HeightRequest="20" WidthRequest="20"
                         Source="gear" Scale="0.7"
                         BackgroundColor="Transparent" Padding="0"
                         SemanticProperties.Description="Settings"
                         Clicked="OnSettingsClicked"
                         VerticalOptions="Center" />
        </Grid>

        <!-- ── HERO (matches website .hero-content) ── -->
        <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="24,8,24,18">
            <Label Text="MANTU GAMES STUDIO"
                   FontFamily="MomoTrustDisplay"
                   FontSize="10"
                   CharacterSpacing="4"
                   TextColor="{StaticResource ColorAccent}"
                   HorizontalOptions="Center"
                   Padding="14,6"
                   HorizontalTextAlignment="Center">
                <Label.BackgroundColor>
                    <Color>#1422D3EE</Color>
                </Label.BackgroundColor>
            </Label>
            <Label FontFamily="MomoTrustDisplay" FontSize="26" FontAttributes="Bold"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   CharacterSpacing="1" TextColor="{StaticResource ColorText}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="PLAY. LEARN. " />
                        <Span Text="EXPLORE." TextColor="{StaticResource ColorAccent}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="Fun games that make learning exciting!"
                   FontFamily="MomoTrustDisplay"
                   FontSize="13"
                   TextColor="{StaticResource ColorMuted}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Border BackgroundColor="{StaticResource ColorPanel}"
                    Stroke="{StaticResource ColorLine}"
                    StrokeThickness="1"
                    Padding="14,2"
                    Margin="0,6,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Entry x:Name="SearchEntry"
                       Placeholder="Search games by name or ID"
                       PlaceholderColor="{StaticResource ColorMuted}"
                       TextColor="{StaticResource ColorText}"
                       FontFamily="MomoTrustDisplay"
                       FontSize="13"
                       BackgroundColor="Transparent"
                       SemanticProperties.Description="Search games by name or ID"
                       TextChanged="OnSearchTextChanged" />
            </Border>
        </VerticalStackLayout>

        <!-- ── GAME GRID (matches website .game-grid) ── -->
        <CollectionView Grid.Row="2"
                        x:Name="GamesCollectionView"
                        ItemsSource="{Binding GamesList}"
                        SelectionMode="None"
                        Margin="12,0,12,8"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource PanelCard}"
                           Padding="0"
                           HasShadow="False"
                           BorderColor="Transparent"
                           CornerRadius="16"
                           HeightRequest="160">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid>
                            <!-- Full-bleed game icon as background -->
                            <Image Source="{Binding ImageName}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                            <!-- Dark gradient overlay for readability -->
                            <BoxView Background="{StaticResource CardOverlayGradient}"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <!-- Title + Description -->
                            <VerticalStackLayout VerticalOptions="End"
                                                 Padding="14,0,14,14"
                                                 Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="15"
                                       FontAttributes="Bold" HorizontalTextAlignment="Center" HorizontalOptions="Center"
                                       TextColor="White"
                                       CharacterSpacing="0.5" />
                                <Label Text="{Binding Description}"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="11" HorizontalTextAlignment="Center" HorizontalOptions="Center"
                                       TextColor="#CCFFFFFF"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <controls:SettingsPopup x:Name="SettingsPopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:ProfilePopup x:Name="ProfilePopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:ProfilePickerPopup x:Name="ProfilePicker" IsVisible="False" Grid.RowSpan="3" />
        <controls:EditProfilePopup x:Name="EditProfilePopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:StatsPopup x:Name="StatsPopup" IsVisible="False" Grid.RowSpan="3" />
        <controls:UpdatePopup x:Name="UpdatePopup" IsVisible="False" Grid.RowSpan="3" />

    </Grid>
</ContentPage>