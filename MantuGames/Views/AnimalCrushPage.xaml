<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False"
             x:Class="MantuGames.Views.AnimalCrushPage"
>
    <AbsoluteLayout>
        <controls:ClayBackground AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,*"
              Padding="12,16,12,8" RowSpacing="8"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR: back | level badge | pause -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Style="{StaticResource ClayFrame}" Grid.Column="0" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="icon_back_round.svg" HeightRequest="28" WidthRequest="28"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <Border Style="{StaticResource ClayFrame}" Grid.Column="1" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#E0566F"
                           FontSize="16" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center" />
                </Border>
                <Border Style="{StaticResource ClayFrame}" Grid.Column="2" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 24"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="pause.svg" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView Grid.Row="1"
                                    TotalSeconds="{Binding TotalSecondsForLevel}"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- SCORE / TARGET -->
            <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center">
                <Border BackgroundColor="#FFFDFA" StrokeThickness="0" Padding="10,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <StackLayout Spacing="0">
                        <Label Text="SCORE" TextColor="#7C6A8E" FontSize="9" FontFamily="MadimiOne"
                               FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding ScoreDisplay}" TextColor="#E0566F"
                               FontSize="14" FontFamily="MadimiOne" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>
            </HorizontalStackLayout>

            <!-- POWER-UPS: hammer | rocket | bomb -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="18"
                  HorizontalOptions="Center">
                <Border x:Name="HammerButton" Grid.Column="0"
                        BackgroundColor="#FFFDFA" Padding="12,6"
                        StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHammerTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="hammer.png" WidthRequest="24" HeightRequest="24"
                               VerticalOptions="Center" />
                        <Label Text="{Binding HammerCount}" TextColor="#7C6A8E"
                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border x:Name="RocketButton" Grid.Column="1"
                        BackgroundColor="#FFFDFA" Padding="12,6"
                        StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRocketTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="rocket.png" WidthRequest="24" HeightRequest="24"
                               VerticalOptions="Center" />
                        <Label Text="{Binding RocketCount}" TextColor="#7C6A8E"
                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border x:Name="BombButton" Grid.Column="2"
                        BackgroundColor="#FFFDFA" Padding="12,6"
                        StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBombTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="bomb.png" WidthRequest="24" HeightRequest="24"
                               VerticalOptions="Center" />
                        <Label Text="{Binding BombCount}" TextColor="#7C6A8E"
                               FontSize="13" FontFamily="MadimiOne" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- BOARD + SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="4" Spacing="8">
                <Grid x:Name="BoardGrid"
                      ColumnSpacing="4" RowSpacing="4"
                      Padding="5,8"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnBoardPan" />
                    </Grid.GestureRecognizers>
                </Grid>

                <VerticalStackLayout Spacing="2" Margin="60,0">
                    <Button x:Name="SolutionButton"
                            Text="💡 Show Solution"
                            FontSize="15" FontAttributes="Bold"
                            TextColor="#3D2C4E" BackgroundColor="#FFA94D"
                            CornerRadius="24" HeightRequest="50"
                            Clicked="OnShowSolutionClicked" />
                    <Label x:Name="SolutionCoinLabel"
                           FontFamily="MadimiOne"
                           FontSize="11"
                           TextColor="#7C6A8E"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>

        </Grid>

        <!-- WIN/LOSS POPUP -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
