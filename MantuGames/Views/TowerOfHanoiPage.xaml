<?xml version="1.0" encoding="utf-8"?>

<ContentPage BackgroundColor="{StaticResource NightBg}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MantuGames.Views.TowerOfHanoiPage"
             xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             Shell.NavBarIsVisible="False">
    <AbsoluteLayout>
        <controls:ClayBackground Variant="Night" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />

        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="6"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Grid.Column="0" Style="{StaticResource NightCircle}" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                    <ImageButton Source="ic_back_white.png" Padding="0" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Clicked="OnBackClicked" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="1" StrokeShape="RoundRectangle 20"
                       Padding="12,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#FFC83D"
                           FontSize="20" FontFamily="Display" HorizontalOptions="Center" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource NightCircle}" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                    <ImageButton Source="ic_pause_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0" Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- TIMER -->
            <controls:GameTimerView Grid.Row="1"
                                    TotalSeconds="{Binding TotalTimerSec}"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- BOARD — 3 poles side by side, built in code-behind -->
            <Grid Grid.Row="2"
                  x:Name="BoardGrid"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="12"
                  Padding="8,12"
                  VerticalOptions="Fill" />

            <!-- MOVES -->
            <Label Grid.Row="3"
                   Text="{Binding MovesDisplay}"
                   FontSize="15" FontFamily="MadimiOne" FontAttributes="Bold"
                   TextColor="#AAA4D8" HorizontalOptions="Center" />

            <!-- SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="4" Spacing="2" Margin="40,0">
                <Button x:Name="SolutionCoinLabel"
                        FontSize="15" FontAttributes="Bold"
                        TextColor="#111114" BackgroundColor="#FFC83D"
                        CornerRadius="20" HeightRequest="44"
                        Clicked="OnShowSolutionClicked" />
                <!-- <Label x:Name="SolutionCoinLabel" -->
                <!--        FontFamily="MadimiOne" -->
                <!--        FontSize="10" -->
                <!--        TextColor="#D9A400" -->
                <!--        HorizontalOptions="Center" /> -->
            </VerticalStackLayout>
        </Grid>

        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>