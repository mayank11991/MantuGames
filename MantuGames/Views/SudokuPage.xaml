<?xml version="1.0" encoding="utf-8"?>
<ContentPage BackgroundColor="{StaticResource NightBg}"
    x:Class="MantuGames.Views.SudokuPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:MantuGames.Converters"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:TimerColorConverter x:Key="TimerColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <controls:ClayBackground Variant="Night" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0,0,1,1" Grid.RowSpan="3" />
        <!-- MAIN CONTENT -->
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Padding="12,16,12,8" RowSpacing="8"
              AbsoluteLayout.LayoutFlags="All"
              AbsoluteLayout.LayoutBounds="0,0,1,1">

            <!-- TOP BAR: Back + Level + Pause -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Border Style="{StaticResource NightCircle}" Grid.Column="0"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_back_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnBackClicked" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="1" StrokeShape="RoundRectangle 20"
                       Padding="16,6"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding LevelDisplay}" TextColor="#FFC83D"
                           FontSize="20" FontFamily="Display" HorizontalOptions="Center" />
                </Border>
                <Border Style="{StaticResource NightCircle}" Grid.Column="2"
                       Padding="0" WidthRequest="48" HeightRequest="48"
                       VerticalOptions="Center">
                    <ImageButton Source="ic_pause_white.png" HeightRequest="24" WidthRequest="24"
                                 BackgroundColor="Transparent" Padding="0"
                                 Clicked="OnPause" />
                </Border>
            </Grid>

            <!-- REUSABLE TIMER CONTROL -->
            <controls:GameTimerView x:Name="TimerView" Grid.Row="2"
                                    SecondsRemaining="{Binding TimeRemainingSec}" />

            <!-- SUDOKU GRID -->
            <Border StrokeThickness="1.5" Stroke="#4D4495" Grid.Row="3" BackgroundColor="#2B2459"
                    Padding="6" Margin="4,0"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid x:Name="SudokuGrid" ColumnSpacing="3" RowSpacing="3" />
            </Border>

            <!-- NUMBER BUTTONS with animal images -->
            <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*,*,Auto"
                  ColumnSpacing="6" Padding="4,6">
                <Border Style="{StaticResource NightCard}" Grid.Column="0" StrokeShape="RoundRectangle 14"
                       Padding="0">
                    <ImageButton Source="cat.png" BackgroundColor="Transparent"
                                 HeightRequest="58" Padding="8"
                                 Command="{Binding EnterNumberCommand}" CommandParameter="1" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="1" StrokeShape="RoundRectangle 14"
                       Padding="0">
                    <ImageButton Source="elephant.png" BackgroundColor="Transparent"
                                 HeightRequest="58" Padding="8"
                                 Command="{Binding EnterNumberCommand}" CommandParameter="2" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="2" StrokeShape="RoundRectangle 14"
                       Padding="0">
                    <ImageButton Source="lion.png" BackgroundColor="Transparent"
                                 HeightRequest="58" Padding="8"
                                 Command="{Binding EnterNumberCommand}" CommandParameter="3" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="3" StrokeShape="RoundRectangle 14"
                       Padding="0">
                    <ImageButton Source="owl.png" BackgroundColor="Transparent"
                                 HeightRequest="58" Padding="8"
                                 Command="{Binding EnterNumberCommand}" CommandParameter="4" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="4" StrokeShape="RoundRectangle 14"
                       Padding="0">
                    <ImageButton Source="butterfly.png" BackgroundColor="Transparent"
                                 HeightRequest="58" Padding="8"
                                 Command="{Binding EnterNumberCommand}" CommandParameter="5" />
                </Border>
                <Border Style="{StaticResource NightCard}" Grid.Column="5" StrokeShape="RoundRectangle 14"
                       Padding="0" WidthRequest="58" HeightRequest="58">
                    <Button Text="⌫" FontSize="28" FontAttributes="Bold"
                            TextColor="#F6F4FF" BackgroundColor="Transparent"
                            Padding="0" Command="{Binding EraseCommand}" />
                </Border>
            </Grid>

            <!-- SHOW SOLUTION -->
            <VerticalStackLayout Grid.Row="5" Spacing="2" Margin="60,0">
                <Button x:Name="SolutionCoinLabel"
                        FontSize="15" FontAttributes="Bold"
                        TextColor="#111114" BackgroundColor="#FFC83D"
                        CornerRadius="24" HeightRequest="50"
                        Clicked="OnShowSolutionClicked" />
                <!-- <Label x:Name="SolutionCoinLabel" -->
                <!--        FontFamily="MadimiOne" -->
                <!--        FontSize="11" -->
                <!--        TextColor="#D9A400" -->
                <!--        HorizontalOptions="Center" /> -->
            </VerticalStackLayout>

        </Grid>

        <!-- REUSABLE WIN/LOSS POPUP — last child = always on top -->
        <controls:GameResultPopup
            x:Name="ResultPopup"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            NextLevelRequested="OnNextLevel"
            RetryRequested="OnRetry" />

        <controls:PauseOverlay x:Name="PauseOverlay" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:ConfirmPopup x:Name="ConfirmPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

        <controls:CoinShopPopup x:Name="CoinShopPopup" IsVisible="False"
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1" />

    </AbsoluteLayout>
</ContentPage>
