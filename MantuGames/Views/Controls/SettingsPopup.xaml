<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MantuGames.Views.Controls.SettingsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <Grid x:Name="Overlay" BackgroundColor="#99111114" InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Grid VerticalOptions="Center"
              HorizontalOptions="Fill"
              Margin="20"
              InputTransparent="False">

            <Border x:Name="DialogCard" Background="#FFFFFF"
                    Stroke="#111114"
                    StrokeThickness="3"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#2A2E45" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10" Padding="20,16">
                    <controls:FitLabel Grid.Row="0"
                           Text="SETTINGS"
                           FontFamily="{DynamicResource ThemeTitleFont}"
                           FontSize="28"
                           TextColor="#111114"
                           HorizontalOptions="Center" />

                    <BoxView Grid.Row="0" HeightRequest="1" Color="#B3FFFFFF"
                             VerticalOptions="End" Margin="0,0,0,-4" />

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default"
                                MaximumHeightRequest="380">
                        <VerticalStackLayout Spacing="10" Padding="0,8">

                            <!-- Active Profile (tap to switch) -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Image x:Name="PopupAvatarImage"
                                       Grid.Column="0"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSwitchProfile" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Label x:Name="PopupPlayerName"
                                       Grid.Column="1"
                                       FontFamily="MadimiOne"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#111114"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSwitchProfile" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <!-- Coins (tap to buy) -->
                                <Border Style="{StaticResource ClayFrame}" Grid.Column="2"
                                       BackgroundColor="#111114"
                                       StrokeShape="RoundRectangle 14"
                                       Padding="10,6"
                                       VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenCoinShop" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="coin.png"
                                               WidthRequest="16" HeightRequest="16"
                                               VerticalOptions="Center" />
                                        <Label x:Name="PopupCoinBalance"
                                               FontFamily="MadimiOne"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                            <!-- Music Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Background Music"
                                       FontFamily="MadimiOne"
                                       FontSize="16"
                                       TextColor="#111114"
                                       VerticalOptions="Center" />
                                <Switch x:Name="MusicSwitch"
                                        Grid.Column="1"
                                        OnColor="#111114"
                                        ThumbColor="#111114"
                                        Toggled="OnMusicToggled" />
                            </Grid>

                            <!-- Sound Effects Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Sound Effects"
                                       FontFamily="MadimiOne"
                                       FontSize="16"
                                       TextColor="#111114"
                                       VerticalOptions="Center" />
                                <Switch x:Name="SfxSwitch"
                                        Grid.Column="1"
                                        OnColor="#111114"
                                        ThumbColor="#111114"
                                        Toggled="OnSfxToggled" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                            <!-- App Version -->
                            <Label x:Name="VersionLabel"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   TextColor="#111114"
                                   HorizontalOptions="Center" />

                            <!-- Statistics -->
                            <Label Text="Statistics"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   TextColor="#111114">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStatistics" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Check for Updates -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Check for Updates"
                                       FontFamily="MadimiOne"
                                       FontSize="16"
                                       TextColor="#111114"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCheckForUpdates" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label x:Name="UpdateStatusLabel"
                                       Grid.Column="1"
                                       FontFamily="MadimiOne"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#111114"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Contact Support -->
                            <Label Text="Contact Support"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#111114">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnContactSupport" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Edit Profile -->
                            <Label Text="Edit Profile"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#111114">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditProfile" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Privacy Policy -->
                            <Label Text="Privacy Policy"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#111114">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyPolicy" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Privacy Choices (UMP; only shown where consent rules apply) -->
                            <Label x:Name="PrivacyChoicesLabel"
                                   Text="Privacy Choices"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#111114"
                                   IsVisible="False">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyChoices" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Rate Us -->
                            <Label Text="Rate Us"
                                   FontFamily="MadimiOne"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#111114">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRateUs" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Remove Ads -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Remove Ads"
                                       FontFamily="MadimiOne"
                                       FontSize="16"
                                       TextColor="#111114"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoveAds" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label x:Name="RemoveAdsStatus"
                                       Grid.Column="1"
                                       FontFamily="MadimiOne"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#111114"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Reset Progress -->
                    <Label Grid.Row="2"
                           Text="Reset All Progress"
                           FontFamily="MadimiOne"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="#FF4F6D">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetProgress" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Close Button -->
                    <Border Style="{StaticResource CtaPillBlue}" Grid.Row="3" HorizontalOptions="Center">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClose" /></Border.GestureRecognizers>
    <Label Text="CLOSE" Style="{StaticResource CtaPillLabel}" />
</Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentView>