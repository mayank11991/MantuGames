<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.SettingsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="#CC0B0E14" InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Grid VerticalOptions="Center"
              HorizontalOptions="Center"
              Padding="28"
              WidthRequest="320"
              InputTransparent="False">

            <Border Background="#182136"
                    Stroke="#2EFFFFFF"
                    StrokeThickness="1"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="16" Padding="24,20,24,20">

                    <Label Text="SETTINGS"
                           FontFamily="Orbitron"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#E7ECF5"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                    <!-- Music Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Background Music"
                               FontFamily="Inter"
                               FontSize="16"
                               TextColor="#E7ECF5"
                               VerticalOptions="Center" />
                        <Switch x:Name="MusicSwitch"
                                Grid.Column="1"
                                OnColor="#22D3EE"
                                ThumbColor="#E7ECF5"
                                Toggled="OnMusicToggled" />
                    </Grid>

                    <!-- Sound Effects Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Sound Effects"
                               FontFamily="Inter"
                               FontSize="16"
                               TextColor="#E7ECF5"
                               VerticalOptions="Center" />
                        <Switch x:Name="SfxSwitch"
                                Grid.Column="1"
                                OnColor="#22D3EE"
                                ThumbColor="#E7ECF5"
                                Toggled="OnSfxToggled" />
                    </Grid>

                    <!-- Dark Mode Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Dark Mode"
                               FontFamily="Inter"
                               FontSize="16"
                               TextColor="#E7ECF5"
                               VerticalOptions="Center" />
                        <Switch x:Name="DarkModeSwitch"
                                Grid.Column="1"
                                OnColor="#22D3EE"
                                ThumbColor="#E7ECF5"
                                Toggled="OnDarkModeToggled" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                    <!-- App Version -->
                    <Label x:Name="VersionLabel"
                           FontFamily="Inter"
                           FontSize="13"
                           TextColor="#9AA7BD"
                           HorizontalOptions="Center" />

                    <!-- Statistics -->
                    <Label Text="Statistics"
                           FontFamily="Inter"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#9AA7BD"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStatistics" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Check for Updates -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Check for Updates"
                               FontFamily="Inter"
                               FontSize="13"
                               TextColor="#9AA7BD"
                               TextDecorations="Underline"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCheckForUpdates" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="UpdateStatusLabel"
                               Grid.Column="1"
                               FontFamily="Orbitron"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#22D3EE"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Contact Support -->
                    <Label Text="Contact Support"
                           FontFamily="Inter"
                           FontSize="13"
                           HorizontalOptions="Start"
                           TextColor="#9AA7BD"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContactSupport" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Edit Profile -->
                    <Label Text="Edit Profile"
                           FontFamily="Inter"
                           FontSize="13"
                           HorizontalOptions="Start"
                           TextColor="#9AA7BD"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditProfile" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Privacy Policy -->
                    <Label Text="Privacy Policy"
                           FontFamily="Inter"
                           FontSize="13"
                           HorizontalOptions="Start"
                           TextColor="#9AA7BD"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrivacyPolicy" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Rate Us -->
                    <Label Text="Rate Us"
                           FontFamily="Inter"
                           FontSize="13"
                           HorizontalOptions="Start"
                           TextColor="#9AA7BD"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRateUs" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Remove Ads -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Remove Ads"
                               FontFamily="Inter"
                               FontSize="13"
                               TextColor="#9AA7BD"
                               TextDecorations="Underline"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemoveAds" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="RemoveAdsStatus"
                               Grid.Column="1"
                               FontFamily="Orbitron"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#22D3EE"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Reset Progress -->
                    <Label Text="Reset All Progress"
                           FontFamily="Inter"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#EF4444"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetProgress" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Close Button -->
                    <Border BackgroundColor="#FF9F1C"
                            StrokeThickness="0"
                            Padding="12,8"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="CLOSE"
                               FontFamily="Orbitron"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#160D02"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClose" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
                </ScrollView>
            </Border>

        </Grid>
    </Grid>

</ContentView>