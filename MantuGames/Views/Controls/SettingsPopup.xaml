<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MantuGames.Views.Controls.SettingsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="#CC0B0E14" InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Grid VerticalOptions="Center"
              HorizontalOptions="Fill"
              Margin="20"
              InputTransparent="False">

            <Border Background="#182136"
                    Stroke="#2EFFFFFF"
                    StrokeThickness="1"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10" Padding="20,16">
                    <Label Grid.Row="0"
                           Text="SETTINGS"
                           FontFamily="MomoTrustDisplay"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#E7ECF5"
                           HorizontalOptions="Center" />

                    <BoxView Grid.Row="0" HeightRequest="1" Color="#2EFFFFFF"
                             VerticalOptions="End" Margin="0,0,0,-4" />

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Default"
                                MaximumHeightRequest="380">
                        <VerticalStackLayout Spacing="10" Padding="0,8">

                            <!-- Music Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Background Music"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="16"
                                       TextColor="#E7ECF5"
                                       VerticalOptions="Center" />
                                <Switch x:Name="MusicSwitch"
                                        Grid.Column="1"
                                        OnColor="#22D3EE"
                                        ThumbColor="#E7ECF5"
                                        Toggled="OnMusicToggled" />
                            </Grid>

                            <!-- Sound Effects Toggle -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Sound Effects"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="16"
                                       TextColor="#E7ECF5"
                                       VerticalOptions="Center" />
                                <Switch x:Name="SfxSwitch"
                                        Grid.Column="1"
                                        OnColor="#22D3EE"
                                        ThumbColor="#E7ECF5"
                                        Toggled="OnSfxToggled" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                            <!-- App Version -->
                            <Label x:Name="VersionLabel"
                                   FontFamily="MomoTrustDisplay"
                                   FontSize="16"
                                   TextColor="#ffffff"
                                   HorizontalOptions="Center" />

                            <!-- Statistics -->
                            <Label Text="Statistics"
                                   FontFamily="MomoTrustDisplay"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   TextColor="#ffffff">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnStatistics" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Check for Updates -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Check for Updates"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="16"
                                       TextColor="#ffffff"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCheckForUpdates" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label x:Name="UpdateStatusLabel"
                                       Grid.Column="1"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#22D3EE"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Contact Support -->
                            <Label Text="Contact Support"
                                   FontFamily="MomoTrustDisplay"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#ffffff">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnContactSupport" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Edit Profile -->
                            <Label Text="Edit Profile"
                                   FontFamily="MomoTrustDisplay"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#ffffff">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditProfile" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Privacy Policy -->
                            <Label Text="Privacy Policy"
                                   FontFamily="MomoTrustDisplay"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#ffffff">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyPolicy" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Rate Us -->
                            <Label Text="Rate Us"
                                   FontFamily="MomoTrustDisplay"
                                   FontSize="16"
                                   HorizontalOptions="Start"
                                   TextColor="#ffffff">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRateUs" />
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Remove Ads -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Remove Ads"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="16"
                                       TextColor="#ffffff"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoveAds" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label x:Name="RemoveAdsStatus"
                                       Grid.Column="1"
                                       FontFamily="MomoTrustDisplay"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#22D3EE"
                                       VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Reset Progress -->
                    <Label Grid.Row="2"
                           Text="Reset All Progress"
                           FontFamily="MomoTrustDisplay"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="#EF4444">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetProgress" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Close Button -->
                    <Border Grid.Row="3"
                            BackgroundColor="#FF9F1C"
                            StrokeThickness="0"
                            Padding="12,8"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="CLOSE"
                               FontFamily="MomoTrustDisplay"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#160D02"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClose" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentView>