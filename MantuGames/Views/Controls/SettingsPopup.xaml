<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.SettingsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="{AppThemeBinding Light=#882D2A3D, Dark=#882D2A3D}" InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Grid VerticalOptions="Center"
              HorizontalOptions="Center"
              Padding="28"
              WidthRequest="320"
              InputTransparent="False">

            <Border Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1B1B}"
                    Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                    StrokeThickness="1"
                    Padding="24"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <Label Text="SETTINGS"
                           FontFamily="BrickSans"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center">
                        <Label.TextColor>
                            <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                        </Label.TextColor>
                    </Label>

                    <BoxView HeightRequest="1">
                        <BoxView.Color>
                            <AppThemeBinding Light="#DCC8A866" Dark="#5A567066" />
                        </BoxView.Color>
                    </BoxView>

                    <!-- Music Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Background Music"
                               FontFamily="BrickSans"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.TextColor>
                                <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                            </Label.TextColor>
                        </Label>
                        <Switch x:Name="MusicSwitch"
                                Grid.Column="1"
                                OnColor="{AppThemeBinding Light=#D4B896, Dark=#DCC8A8}"
                                ThumbColor="{AppThemeBinding Light=#4A3728, Dark=#F0E6D8}"
                                Toggled="OnMusicToggled" />
                    </Grid>

                    <!-- Vibration Toggle -->
                    <!-- <Grid ColumnDefinitions="*,Auto"> -->
                    <!--     <Label Grid.Column="0" -->
                    <!--            Text="Vibration" -->
                    <!--            FontFamily="BrickSans" -->
                    <!--            FontSize="16" -->
                    <!--            VerticalOptions="Center"> -->
                    <!--         <Label.TextColor> -->
                    <!--             <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" /> -->
                    <!--         </Label.TextColor> -->
                    <!--     </Label> -->
                    <!--     <Switch x:Name="VibrationSwitch" -->
                    <!--             Grid.Column="1" -->
                    <!--             OnColor="{AppThemeBinding Light=#D4B896, Dark=#DCC8A8}" -->
                    <!--             ThumbColor="{AppThemeBinding Light=#4A3728, Dark=#F0E6D8}" -->
                    <!--             Toggled="OnVibrationToggled" /> -->
                    <!-- </Grid> -->

                    <!-- Dark Mode Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Dark Mode"
                               FontFamily="BrickSans"
                               FontSize="16"
                               VerticalOptions="Center">
                            <Label.TextColor>
                                <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                            </Label.TextColor>
                        </Label>
                        <Switch x:Name="DarkModeSwitch"
                                Grid.Column="1"
                                OnColor="{AppThemeBinding Light=#D4B896, Dark=#DCC8A8}"
                                ThumbColor="{AppThemeBinding Light=#4A3728, Dark=#F0E6D8}"
                                Toggled="OnDarkModeToggled" />
                    </Grid>

                    <BoxView HeightRequest="1">
                        <BoxView.Color>
                            <AppThemeBinding Light="#DCC8A866" Dark="#5A567066" />
                        </BoxView.Color>
                    </BoxView>

                    <!-- App Version -->
                    <Label x:Name="VersionLabel"
                           FontFamily="BrickSans"
                           FontSize="13"
                           HorizontalOptions="Center">
                        <Label.TextColor>
                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                        </Label.TextColor>
                    </Label>

                    <!-- Edit Profile -->
                    <Label Text="Edit Profile"
                           FontFamily="BrickSans"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextDecorations="Underline">
                        <Label.TextColor>
                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                        </Label.TextColor>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditProfile" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Reset Progress -->
                    <Label Text="Reset All Progress"
                           FontFamily="BrickSans"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextDecorations="Underline">
                        <Label.TextColor>
                            <AppThemeBinding Light="#C0392B" Dark="#EF5350" />
                        </Label.TextColor>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetProgress" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Close Button -->
                    <Border BackgroundColor="#D4B896"
                            StrokeThickness="0"
                            Padding="12,8"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="CLOSE"
                               FontFamily="BrickSans"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center">
                            <Label.TextColor>
                                <AppThemeBinding Light="#FFFFFF" Dark="#1F1B1B" />
                            </Label.TextColor>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClose" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
            </Border>

        </Grid>
    </Grid>

</ContentView>
