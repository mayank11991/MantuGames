<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.AgeGatePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <!-- Neutral age screen: asked once, no default year, no hint about which answer "works". -->
    <Grid BackgroundColor="#991F2A44" InputTransparent="False">
        <Border Background="#FFFFFF"
                Stroke="#1F2A44"
                StrokeThickness="3"
                Padding="28"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#1F2A44" Offset="0,8" Radius="0" Opacity="0.9" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18" HorizontalOptions="Fill">
                <Image Source="cat.png" HeightRequest="84" HorizontalOptions="Center" />

                <controls:FitLabel Text="HELLO!"
                                   FontFamily="Display"
                                   FontSize="26"
                                   TextColor="#111114"
                                   HorizontalOptions="Center" />

                <Label Text="What year were you born?"
                       FontFamily="MadimiOne"
                       FontSize="16"
                       TextColor="#6E6E7C"
                       HorizontalTextAlignment="Center" />

                <Border Stroke="#1F2A44" StrokeThickness="2" Padding="12,2" BackgroundColor="#F4F6FB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Picker x:Name="YearPicker"
                            Title="Choose a year"
                            TitleColor="#9AA3B2"
                            TextColor="#111114"
                            FontFamily="Display"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            SelectedIndexChanged="OnYearChanged" />
                </Border>

                <Border x:Name="ContinueBorder"
                        Style="{StaticResource CtaPillOrange}"
                        Opacity="0.45">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContinue" />
                    </Border.GestureRecognizers>
                    <Label Text="CONTINUE" Style="{StaticResource CtaPillLabel}" />
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
