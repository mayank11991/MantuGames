<?xml version="1.0" encoding="UTF-8" ?>
<!-- Full-page backdrop. Variant: Lime (default, shell), Sky, Night (game screens). -->
<ContentView
    x:Class="MantuGames.Views.Controls.ClayBackground"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    InputTransparent="True">

    <Grid x:Name="Root" Background="{StaticResource GradLime}">
        <!-- Soft glow blobs; colours set per variant in code-behind -->
        <Ellipse x:Name="Glow1"
                 WidthRequest="420" HeightRequest="420"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-180,-200,0" />
        <Ellipse x:Name="Glow2"
                 WidthRequest="360" HeightRequest="360"
                 HorizontalOptions="Start" VerticalOptions="End"
                 Margin="-200,0,0,-120" />
    </Grid>
</ContentView>
