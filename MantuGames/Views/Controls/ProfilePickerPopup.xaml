<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ProfilePickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="#663D2C4E">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <!-- Centered dialog container -->
        <Grid x:Name="Sheet"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Margin="24,60,24,40"
              WidthRequest="320">

            <!-- Dialog Border (content area) -->
            <Border x:Name="DialogBorder"
                    BackgroundColor="#FFFDFA"
                    Stroke="#B3FFFFFF"
                    StrokeThickness="2"
                    Padding="0"
                    Margin="0,30,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#8A6FA8" Offset="0,8" Radius="20" Opacity="0.4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSheetTapped" />
                </Border.GestureRecognizers>

                <Grid Padding="16,65,16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Subtitle -->
                    <Label Grid.Row="0"
                           x:Name="SubtitleLabel"
                           Text="✦  Pick your character and start playing!  ✦"
                           FontFamily="MadimiOne"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#7C6A8E"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

                    <!-- Row 1: Profile tiles grid -->
                    <FlexLayout x:Name="ProfilesLayout"
                                Grid.Row="1"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center"
                                AlignContent="Center"
                                HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- Banner image ON TOP of dialog (half above, half overlapping) -->
            <Image x:Name="BannerImage"
                   Source="profile_header.png"
                   Aspect="AspectFit"
                   HeightRequest="90"
                   WidthRequest="300"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,0,0,0"
                   InputTransparent="True" />
        </Grid>
    </Grid>
</ContentView>
