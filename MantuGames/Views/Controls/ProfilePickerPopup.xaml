<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ProfilePickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <Grid x:Name="Overlay" BackgroundColor="#99111114">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <!-- Centered dialog container -->
        <Grid x:Name="Sheet"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Margin="24,60,24,40"
              WidthRequest="320">

            <!-- Dialog Border (content area) -->
            <Border x:Name="DialogBorder"
                    BackgroundColor="#FFFFFF"
                    Stroke="#111114"
                    StrokeThickness="3"
                    Padding="0"
                    Margin="0,30,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#2A2E45" Offset="0,8" Radius="20" Opacity="0.4" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSheetTapped" />
                </Border.GestureRecognizers>

                <Grid Padding="16,65,16,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Subtitle -->
                    <Label Grid.Row="0"
                           x:Name="SubtitleLabel"
                           Text="✦  Pick your character and start playing!  ✦"
                           FontFamily="MadimiOne"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#6E6E7C"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

                    <!-- Row 1: Profile tiles grid -->
                    <FlexLayout x:Name="ProfilesLayout"
                                Grid.Row="1"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center"
                                AlignContent="Center"
                                HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- Banner image ON TOP of dialog (half above, half overlapping) -->
            <!-- Title tag ON TOP of dialog (half above, half overlapping) -->
            <Border x:Name="BannerImage"
                    BackgroundColor="#111114"
                    StrokeThickness="0"
                    Padding="22,8,22,4"
                    Rotation="-3"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,22,0,0"
                    InputTransparent="True">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#D9F84A" Offset="5,6" Radius="0" Opacity="1" />
                </Border.Shadow>
                <controls:FitLabel SideInset="90" Text="WHO'S PLAYING?" FontFamily="Display" FontSize="32" TextColor="#FFFFFF" />
            </Border>
        </Grid>
    </Grid>
</ContentView>
