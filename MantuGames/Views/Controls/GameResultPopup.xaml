<?xml version="1.0" encoding="utf-8"?>
<ContentView
    x:Class="MantuGames.Views.Controls.GameResultPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    IsVisible="False">

    <Grid>
        <!-- Dim backdrop -->
        <BoxView BackgroundColor="#99111114" HorizontalOptions="Fill" VerticalOptions="Fill" />

        <!-- Popup card -->
        <Border x:Name="PopupCard"
                StrokeThickness="3"
                Stroke="#111114"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="310">
            <Border.BackgroundColor>
                <AppThemeBinding Light="#FFFFFF" Dark="#FFFFFF" />
            </Border.BackgroundColor>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#FFC83D" Offset="7,9" Radius="0" Opacity="1"/>
            </Border.Shadow>

            <StackLayout Spacing="0" Padding="24,20,24,28">

                <!-- Hero icon (trophy or clock) -->
                <Image x:Name="HeroIcon"
                       HeightRequest="100"
                       WidthRequest="100"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8"/>

                <!-- Stars row (win only) -->
                <StackLayout x:Name="StarsRow"
                             Orientation="Horizontal"
                             HorizontalOptions="Center"
                             Spacing="6"
                             IsVisible="False"
                             Margin="0,0,0,6">
                    <Image x:Name="StarImg1" HeightRequest="48" WidthRequest="48"/>
                    <Image x:Name="StarImg2" HeightRequest="48" WidthRequest="48"/>
                    <Image x:Name="StarImg3" HeightRequest="48" WidthRequest="48"/>
                </StackLayout>

                <!-- Title -->
                <controls:FitLabel x:Name="TitleLabel"
                       FontFamily="{DynamicResource ThemeTitleFont}"
                       FontSize="36"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       Margin="0,0,0,2"/>

                <!-- Points badge -->
                <Border x:Name="PointsBadge"
                        BackgroundColor="#D9F84A"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Margin="0,4,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label x:Name="PointsLabel"
                           FontFamily="MadimiOne"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#111114"
                           Padding="14,5"/>
                </Border>

                <!-- Daily challenge completed (win only) -->
                <Border x:Name="DailyBadge"
                        BackgroundColor="#FFE0C2"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Margin="0,2,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label x:Name="DailyLabel"
                           FontFamily="Baloo2ExtraBold"
                           FontSize="14"
                           TextColor="#111114"
                           HorizontalTextAlignment="Center"
                           Padding="14,5"/>
                </Border>

                <!-- New badge earned with this result -->
                <Border x:Name="BadgeBanner"
                        BackgroundColor="#FFF4CC"
                        Stroke="#FFC83D" StrokeThickness="2"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        Padding="10,5,14,5"
                        Margin="0,2,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8">
                        <Image x:Name="BadgeIcon" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                        <Label x:Name="BadgeLabel" FontFamily="Baloo2ExtraBold" FontSize="13"
                               TextColor="#111114" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Opt-in rewarded ad: double this level's coins -->
                <Border x:Name="DoubleBorder" Style="{StaticResource CtaPillYellow}"
                        HorizontalOptions="Center" Padding="16,7" Margin="0,6,0,4" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDoubleClicked"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="ic_play_ink.png" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                        <Label x:Name="DoubleLabel" Text="WATCH AD: ×2 COINS"
                               Style="{StaticResource CtaPillLabelDark}" FontSize="15" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Message -->
                <Label x:Name="MessageLabel"
                       FontSize="14"
                       TextColor="#6E6E7C"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,4,0,18"/>

                <!-- Primary action: candy button (green = Next Level, orange = Try Again; set in code) -->
                <Border x:Name="PrimaryBorder" Style="{StaticResource CtaPillGreen}"
                        HorizontalOptions="Fill" Padding="0" Margin="0,0,0,12">
                    <Grid HeightRequest="56">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrimaryClicked"/>
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image x:Name="PrimaryIcon" HeightRequest="22" WidthRequest="22" VerticalOptions="Center"/>
                            <Label x:Name="PrimaryLabel" Style="{StaticResource CtaPillLabel}" FontSize="22"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Secondary action (Retry, win screen only): blue candy button -->
                <Border x:Name="SecondaryBorder" Style="{StaticResource CtaPillBlue}"
                        HorizontalOptions="Fill" Padding="0" IsVisible="False">
                    <Grid HeightRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSecondaryClicked"/>
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="ic_refresh_white.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center"/>
                            <Label Text="RETRY" Style="{StaticResource CtaPillLabel}"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

            </StackLayout>
        </Border>

        <!-- Win celebration: confetti over everything, never blocks taps -->
        <controls:ConfettiView x:Name="Confetti" InputTransparent="True" />

    </Grid>
</ContentView>
