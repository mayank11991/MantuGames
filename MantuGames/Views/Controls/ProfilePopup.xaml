<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ProfilePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <Grid x:Name="Overlay"
          BackgroundColor="#991F2A44"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="#FFFFFF"
                Stroke="#1F2A44"
                StrokeThickness="3"
                Padding="22,24"
                WidthRequest="320"
                                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#2A2E45" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <controls:FitLabel Text="Create Profile"
                           FontFamily="Display"
                           FontSize="30"
                           TextColor="#111114"
                           HorizontalOptions="Center" />

                    <Label Text="Who is playing?"
                           FontFamily="MadimiOne"
                           FontSize="12"
                           TextColor="#6E6E7C"
                           HorizontalOptions="Center" />

                    <!-- Name -->
                    <Border Background="#F5F6FA"
                            Stroke="#B3FFFFFF"
                            StrokeThickness="1"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="NameEntry"
                               Placeholder="Your name"
                               PlaceholderColor="#6E6E7C"
                               FontFamily="MadimiOne"
                               FontSize="16"
                               TextColor="#111114"
                               BackgroundColor="Transparent" />
                    </Border>

                    <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                    <Label Text="Choose Avatar"
                           FontFamily="MadimiOne"
                           FontSize="14"
                           TextColor="#111114"
                           HorizontalOptions="Center" />

                    <!-- Avatar Picker Grid (A1-A7) -->
                    <Grid x:Name="AvatarPickerGrid"
                          ColumnDefinitions="*,*,*,*" ColumnSpacing="8" HorizontalOptions="Center"
                          RowDefinitions="Auto,Auto" RowSpacing="8">
                    </Grid>

                    <!-- Done / Cancel Buttons -->
                    <HorizontalStackLayout Spacing="12"
                                           HorizontalOptions="Center"
                                           Margin="0,4,0,0">
                        <Border Style="{StaticResource CtaPillBlue}" >
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCancel" /></Border.GestureRecognizers>
    <Label Text="CANCEL" Style="{StaticResource CtaPillLabel}" />
</Border>
                        <Border Style="{StaticResource CtaPillGreen}" >
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSubmit" /></Border.GestureRecognizers>
    <Label Text="CREATE" Style="{StaticResource CtaPillLabel}" />
</Border>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
