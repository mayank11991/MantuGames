<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ProfilePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#663D2C4E"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="#FFFDFA"
                Stroke="#B3FFFFFF"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="320"
                MaximumHeightRequest="480"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#8A6FA8" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <Label Text="Create Profile"
                           FontFamily="MadimiOne"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#3D2C4E"
                           HorizontalOptions="Center" />

                    <Label Text="Who is playing?"
                           FontFamily="MadimiOne"
                           FontSize="12"
                           TextColor="#7C6A8E"
                           HorizontalOptions="Center" />

                    <!-- Name -->
                    <Border Background="#F4E9FF"
                            Stroke="#B3FFFFFF"
                            StrokeThickness="1"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="NameEntry"
                               Placeholder="Your name"
                               PlaceholderColor="#8A78A0"
                               FontFamily="MadimiOne"
                               FontSize="16"
                               TextColor="#3D2C4E"
                               BackgroundColor="Transparent" />
                    </Border>

                    <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                    <Label Text="Choose Avatar"
                           FontFamily="MadimiOne"
                           FontSize="14"
                           TextColor="#3D2C4E"
                           HorizontalOptions="Center" />

                    <!-- Avatar Picker Grid (A1-A7) -->
                    <Grid x:Name="AvatarPickerGrid"
                          ColumnDefinitions="*,*,*,*" ColumnSpacing="10"
                          RowDefinitions="*,*" RowSpacing="10"
                          HeightRequest="140">
                    </Grid>

                    <!-- Done / Cancel Buttons -->
                    <HorizontalStackLayout Spacing="12"
                                           HorizontalOptions="Center"
                                           Margin="0,4,0,0">
                        <Border BackgroundColor="#E9DEFF"
                                Stroke="#B3FFFFFF"
                                StrokeThickness="2"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancel" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="CANCEL"
                                   FontFamily="MadimiOne"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#3D2C4E"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="#3D2C4E"
                                StrokeThickness="0"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubmit" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="CREATE"
                                   FontFamily="MadimiOne"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentView>
