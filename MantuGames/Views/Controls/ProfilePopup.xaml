<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ProfilePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#882D2A3D"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="{AppThemeBinding Light=#FBF4ED, Dark=#2D2A3D}"
                Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="320"
                MaximumHeightRequest="480"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <Label Text="Welcome!"
                           FontFamily="BrickSans"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center">
                        <Label.TextColor>
                            <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                        </Label.TextColor>
                    </Label>

                    <Label Text="Tell us about yourself"
                           FontFamily="BrickSans"
                           FontSize="12"
                           HorizontalOptions="Center">
                        <Label.TextColor>
                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                        </Label.TextColor>
                    </Label>

                    <!-- Name -->
                    <Border Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1B1B}"
                            Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                            StrokeThickness="1"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="NameEntry"
                               Placeholder="Your name"
                               PlaceholderColor="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                               FontFamily="BrickSans"
                               FontSize="16"
                               BackgroundColor="Transparent">
                            <Entry.TextColor>
                                <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                            </Entry.TextColor>
                        </Entry>
                    </Border>

                    <BoxView HeightRequest="1">
                        <BoxView.Color>
                            <AppThemeBinding Light="#DCC8A866" Dark="#5A567066" />
                        </BoxView.Color>
                    </BoxView>

                    <Label Text="Your Birthday"
                           FontFamily="BrickSans"
                           FontSize="14"
                           HorizontalOptions="Center">
                        <Label.TextColor>
                            <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                        </Label.TextColor>
                    </Label>

                    <!-- Tap Spinners: 3-row zones — top=up, middle=value, bottom=down -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" HeightRequest="140">

                        <!-- Day Spinner -->
                        <Border Grid.Column="0"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1B1B}"
                                Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                                StrokeThickness="1"
                                Padding="4,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="*,Auto,*">
                                <!-- Top zone: tap to increment -->
                                <Grid Grid.Row="0" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDayUpTap" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="▲"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End">
                                        <Label.TextColor>
                                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                                <!-- Value -->
                                <Label x:Name="DayLabel"
                                       Grid.Row="1"
                                       Text="1"
                                       FontFamily="BrickSans"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.TextColor>
                                        <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                                    </Label.TextColor>
                                </Label>
                                <!-- Bottom zone: tap to decrement -->
                                <Grid Grid.Row="2" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDayDownTap" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="▼"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Start">
                                        <Label.TextColor>
                                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Month Spinner -->
                        <Border Grid.Column="1"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1B1B}"
                                Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                                StrokeThickness="1"
                                Padding="4,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="*,Auto,*">
                                <Grid Grid.Row="0" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMonthUpTap" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="▲"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End">
                                        <Label.TextColor>
                                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                                <Label x:Name="MonthLabel"
                                       Grid.Row="1"
                                       Text="Jan"
                                       FontFamily="BrickSans"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.TextColor>
                                        <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                                    </Label.TextColor>
                                </Label>
                                <Grid Grid.Row="2" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMonthDownTap" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="▼"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Start">
                                        <Label.TextColor>
                                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Year Spinner -->
                        <Border Grid.Column="2"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#1F1B1B}"
                                Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                                StrokeThickness="1"
                                Padding="4,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="*,Auto,*">
                                <Grid Grid.Row="0" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnYearUpTap" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="▲"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End">
                                        <Label.TextColor>
                                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                                <Label x:Name="YearLabel"
                                       Grid.Row="1"
                                       Text="2000"
                                       FontFamily="BrickSans"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.TextColor>
                                        <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                                    </Label.TextColor>
                                </Label>
                                <Grid Grid.Row="2" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnYearDownTap" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="▼"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Start">
                                        <Label.TextColor>
                                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- Done Button -->
                    <Border BackgroundColor="#D4B896"
                            StrokeThickness="0"
                            Padding="20,10"
                            HorizontalOptions="Center"
                            Margin="0,4,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="LET'S PLAY!"
                               FontFamily="BrickSans"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center">
                            <Label.TextColor>
                                <AppThemeBinding Light="#FFFFFF" Dark="#1F1B1B" />
                            </Label.TextColor>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubmit" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                    <Label Text="Skip for now"
                           FontFamily="BrickSans"
                           FontSize="12"
                           HorizontalOptions="Center"
                           TextDecorations="Underline">
                        <Label.TextColor>
                            <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                        </Label.TextColor>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSkip" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentView>
