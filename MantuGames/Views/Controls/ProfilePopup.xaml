<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ProfilePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#CC0B0E14"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="#182136"
                Stroke="#2EFFFFFF"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="320"
                MaximumHeightRequest="480"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Spacing="16">

                    <Label Text="Create Profile"
                           FontFamily="Orbitron"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#E7ECF5"
                           HorizontalOptions="Center" />

                    <Label Text="Who is playing?"
                           FontFamily="Inter"
                           FontSize="12"
                           TextColor="#9AA7BD"
                           HorizontalOptions="Center" />

                    <!-- Name -->
                    <Border Background="#0F1420"
                            Stroke="#2EFFFFFF"
                            StrokeThickness="1"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="NameEntry"
                               Placeholder="Your name"
                               PlaceholderColor="#6B7A93"
                               FontFamily="Inter"
                               FontSize="16"
                               TextColor="#E7ECF5"
                               BackgroundColor="Transparent" />
                    </Border>

                    <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                    <Label Text="Your Birthday"
                           FontFamily="Orbitron"
                           FontSize="14"
                           TextColor="#E7ECF5"
                           HorizontalOptions="Center" />

                    <!-- Swipe Spinners: swipe up to increase, down to decrease -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" HeightRequest="140">

                        <!-- Day Spinner -->
                        <Border Grid.Column="0"
                                Background="#0F1420"
                                Stroke="#2EFFFFFF"
                                StrokeThickness="1"
                                Padding="4,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnDayPan" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="*,Auto,*">
                                <Label Grid.Row="0" Text="▲"
                                       FontSize="22"
                                       TextColor="#9AA7BD"
                                       HorizontalOptions="Center"
                                       VerticalOptions="End" />
                                <Label x:Name="DayLabel"
                                       Grid.Row="1"
                                       Text="1"
                                       FontFamily="Orbitron"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#22D3EE"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="2" Text="▼"
                                       FontSize="22"
                                       TextColor="#9AA7BD"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>

                        <!-- Month Spinner -->
                        <Border Grid.Column="1"
                                Background="#0F1420"
                                Stroke="#2EFFFFFF"
                                StrokeThickness="1"
                                Padding="4,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnMonthPan" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="*,Auto,*">
                                <Label Grid.Row="0" Text="▲"
                                       FontSize="22"
                                       TextColor="#9AA7BD"
                                       HorizontalOptions="Center"
                                       VerticalOptions="End" />
                                <Label x:Name="MonthLabel"
                                       Grid.Row="1"
                                       Text="Jan"
                                       FontFamily="Orbitron"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#A855F7"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="2" Text="▼"
                                       FontSize="22"
                                       TextColor="#9AA7BD"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>

                        <!-- Year Spinner -->
                        <Border Grid.Column="2"
                                Background="#0F1420"
                                Stroke="#2EFFFFFF"
                                StrokeThickness="1"
                                Padding="4,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnYearPan" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="*,Auto,*">
                                <Label Grid.Row="0" Text="▲"
                                       FontSize="22"
                                       TextColor="#9AA7BD"
                                       HorizontalOptions="Center"
                                       VerticalOptions="End" />
                                <Label x:Name="YearLabel"
                                       Grid.Row="1"
                                       Text="2000"
                                       FontFamily="Orbitron"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FF9F1C"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="2" Text="▼"
                                       FontSize="22"
                                       TextColor="#9AA7BD"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- Done Button -->
                    <Border BackgroundColor="#FF9F1C"
                            StrokeThickness="0"
                            Padding="20,10"
                            HorizontalOptions="Center"
                            Margin="0,4,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="CREATE PROFILE"
                               FontFamily="Orbitron"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#160D02"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubmit" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentView>