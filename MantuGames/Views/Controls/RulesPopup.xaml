<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.RulesPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#99111114"
          InputTransparent="False">

        <Border Background="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF}"
                Stroke="{AppThemeBinding Light=#B3FFFFFF, Dark=#B3FFFFFF}"
                StrokeThickness="1"
                Padding="24"
                MaximumWidthRequest="340"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <Label x:Name="TitleLabel"
                       Text="How to Play"
                       FontFamily="Display"
                       FontSize="28"
                       TextColor="#111114"
                       HorizontalOptions="Center" />
                <ScrollView MaximumHeightRequest="320">
                    <Label x:Name="BodyLabel"
                           FontFamily="MadimiOne"
                           FontSize="15"
                           LineHeight="1.5"
                           TextColor="#6E6E7C"
                           HorizontalOptions="Start" />
                </ScrollView>
                <Border Style="{StaticResource CtaPillGreen}" HorizontalOptions="Center" WidthRequest="140">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDismiss" /></Border.GestureRecognizers>
    <Label Text="GOT IT!" Style="{StaticResource CtaPillLabel}" />
</Border>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
