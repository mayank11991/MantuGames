<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.RulesPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="{AppThemeBinding Light=#882D2A3D, Dark=#882D2A3D}"
          InputTransparent="False">

        <Border Background="{AppThemeBinding Light=#FBF4ED, Dark=#2D2A3D}"
                Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                StrokeThickness="1"
                Padding="24"
                MaximumWidthRequest="340"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <Label x:Name="TitleLabel"
                       Text="How to Play"
                       FontFamily="BrickSans"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#2D2A3D, Dark=#F0E6D8}"
                       HorizontalOptions="Center" />
                <ScrollView MaximumHeightRequest="320">
                    <Label x:Name="BodyLabel"
                           FontFamily="BrickSans"
                           FontSize="15"
                           LineHeight="1.5"
                           TextColor="{AppThemeBinding Light=#5D4037, Dark=#E0D5C5}"
                           HorizontalOptions="Start" />
                </ScrollView>
                <Border BackgroundColor="#D4B896"
                        StrokeThickness="0"
                        Padding="32,10"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="140">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Label Text="Got it!"
                           FontFamily="BrickSans"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDismiss" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
