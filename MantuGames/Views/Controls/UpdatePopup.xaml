<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.UpdatePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <Grid x:Name="Overlay" BackgroundColor="#99111114" InputTransparent="False">
        <Grid VerticalOptions="Center"
              HorizontalOptions="Center"
              Padding="28"
              InputTransparent="False">

            <Border x:Name="DialogCard" Background="#FFFFFF"
                    Stroke="#111114"
                    StrokeThickness="3"
                    Padding="24"
                    WidthRequest="320"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#2A2E45" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18" HorizontalOptions="Center">

                    <controls:FitLabel x:Name="TitleLabel"
                           Text="Update Available"
                           FontFamily="{DynamicResource ThemeTitleFont}"
                           FontSize="26"
                           TextColor="#111114"
                           HorizontalOptions="Center" />

                    <Label x:Name="VersionLabel"
                           FontFamily="MadimiOne"
                           FontSize="13"
                           TextColor="#6E6E7C"
                           HorizontalOptions="Center" />

                    <ScrollView MaximumHeightRequest="140">
                        <Label x:Name="NotesLabel"
                               FontFamily="MadimiOne"
                               FontSize="14"
                               LineHeight="1.4"
                               TextColor="#6E6E7C" />
                    </ScrollView>

                    <Border Style="{StaticResource CtaPillGreen}" x:Name="UpdateBorder" HorizontalOptions="Center" WidthRequest="140">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnUpdate" /></Border.GestureRecognizers>
    <Label Text="UPDATE NOW" Style="{StaticResource CtaPillLabel}" />
</Border>

                    <Label x:Name="LaterLabel"
                           Text="Not now"
                           FontFamily="MadimiOne"
                           FontSize="13"
                           TextColor="#6E6E7C"
                           TextDecorations="Underline"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLater" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>