<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#663D2C4E"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="{AppThemeBinding Light=#FFFDFA, Dark=#FFFDFA}"
                Stroke="{AppThemeBinding Light=#B3FFFFFF, Dark=#B3FFFFFF}"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#8A6FA8" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                <Label x:Name="TitleLabel"
                       FontFamily="MadimiOne"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#3D2C4E" Dark="#3D2C4E" />
                    </Label.TextColor>
                </Label>

                <Label x:Name="MessageLabel"
                       FontFamily="MadimiOne"
                       FontSize="14"
                       HorizontalTextAlignment="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#7C6A8E" Dark="#7C6A8E" />
                    </Label.TextColor>
                </Label>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalOptions="Center">
                    <Border x:Name="SecondaryBorder"
                            Grid.Column="0"
                            BackgroundColor="#CCFFFFFF"
                            StrokeThickness="1"
                            Stroke="#B3FFFFFF"
                            Padding="20,10"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="CancelLabel"
                               FontFamily="MadimiOne"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#3D2C4E">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancel" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border x:Name="PrimaryBorder"
                            Grid.Column="1"
                            BackgroundColor="#E0566F"
                            StrokeThickness="0"
                            Padding="20,10"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="ConfirmLabel"
                               FontFamily="MadimiOne"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#3D2C4E">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirm" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
