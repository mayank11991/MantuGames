<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#CC0B0E14"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="{AppThemeBinding Light=#182136, Dark=#182136}"
                Stroke="{AppThemeBinding Light=#2EFFFFFF, Dark=#2EFFFFFF}"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                <Label x:Name="TitleLabel"
                       FontFamily="Orbitron"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#E7ECF5" Dark="#E7ECF5" />
                    </Label.TextColor>
                </Label>

                <Label x:Name="MessageLabel"
                       FontFamily="Inter"
                       FontSize="14"
                       HorizontalTextAlignment="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#9AA7BD" Dark="#9AA7BD" />
                    </Label.TextColor>
                </Label>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalOptions="Center">
                    <Border x:Name="SecondaryBorder"
                            Grid.Column="0"
                            BackgroundColor="#0FFFFFFF"
                            StrokeThickness="1"
                            Stroke="#2EFFFFFF"
                            Padding="20,10"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="CancelLabel"
                               FontFamily="Orbitron"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#E7ECF5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancel" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border x:Name="PrimaryBorder"
                            Grid.Column="1"
                            BackgroundColor="#EF4444"
                            StrokeThickness="0"
                            Padding="20,10"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="ConfirmLabel"
                               FontFamily="Orbitron"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#160D02">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirm" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
