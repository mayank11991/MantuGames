<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#991F2A44"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF}"
                Stroke="#1F2A44"
                StrokeThickness="3"
                Padding="28"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#1F2A44" Offset="0,8" Radius="0" Opacity="0.9" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20" HorizontalOptions="Fill">

                <Label x:Name="TitleLabel"
                       FontFamily="Display"
                       FontSize="26"
                       HorizontalOptions="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#111114" Dark="#111114" />
                    </Label.TextColor>
                </Label>

                <Label x:Name="MessageLabel"
                       FontFamily="MadimiOne"
                       FontSize="14"
                       HorizontalTextAlignment="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#6E6E7C" Dark="#6E6E7C" />
                    </Label.TextColor>
                </Label>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" HorizontalOptions="Fill">
                    <!-- Cancel / safe choice: blue candy button -->
                    <Border x:Name="SecondaryBorder" Grid.Column="0"
                            Style="{StaticResource CtaPillBlue}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancel" />
                        </Border.GestureRecognizers>
                        <Label x:Name="CancelLabel" Style="{StaticResource CtaPillLabel}" />
                    </Border>
                    <!-- Confirm: orange candy button -->
                    <Border x:Name="PrimaryBorder" Grid.Column="1"
                            Style="{StaticResource CtaPillOrange}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConfirm" />
                        </Border.GestureRecognizers>
                        <Label x:Name="ConfirmLabel" Style="{StaticResource CtaPillLabel}" />
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
