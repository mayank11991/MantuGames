<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="{AppThemeBinding Light=#882D2A3D, Dark=#882D2A3D}"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>

        <Border Background="{AppThemeBinding Light=#FBF4ED, Dark=#2D2A3D}"
                Stroke="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#DCC8A8, Dark=#5A5670}" Offset="0,6" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                <Label x:Name="TitleLabel"
                       FontFamily="BrickSans"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#4A3728" Dark="#F0E6D8" />
                    </Label.TextColor>
                </Label>

                <Label x:Name="MessageLabel"
                       FontFamily="BrickSans"
                       FontSize="14"
                       HorizontalTextAlignment="Center">
                    <Label.TextColor>
                        <AppThemeBinding Light="#8B7B6A" Dark="#B0A696" />
                    </Label.TextColor>
                </Label>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalOptions="Center">
                    <Border x:Name="SecondaryBorder"
                            Grid.Column="0"
                            BackgroundColor="#DCC8A8"
                            StrokeThickness="0"
                            Padding="20,10"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="CancelLabel"
                               FontFamily="BrickSans"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#4A3728">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancel" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Border x:Name="PrimaryBorder"
                            Grid.Column="1"
                            BackgroundColor="#EF5350"
                            StrokeThickness="0"
                            Padding="20,10"
                            HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="ConfirmLabel"
                               FontFamily="BrickSans"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="White">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConfirm" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
