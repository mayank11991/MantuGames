<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.PauseOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#991F2A44"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Border x:Name="DialogCard" Style="{StaticResource NightCard}"
                Padding="44,30"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="22">
                <Border Style="{StaticResource NightCircle}" WidthRequest="64" HeightRequest="64"
                        HorizontalOptions="Center">
                    <Image Source="ic_pause_white.png" WidthRequest="30" HeightRequest="30" />
                </Border>
                <Label Text="PAUSED" Style="{StaticResource NightTitle}" FontSize="44"
                       HorizontalOptions="Center" />
                <Border Style="{StaticResource NightAction}" Padding="36,14" HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnResume" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="ic_play_ink.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Text="RESUME" FontFamily="Baloo2ExtraBold" FontSize="16"
                               TextColor="#111114" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
