<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.PauseOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#663D2C4E"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Border BackgroundColor="#FFFDFA"
                Stroke="#B3FFFFFF"
                StrokeThickness="1"
                Padding="40,32"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#8A6FA8" Offset="0,8" Radius="24" Opacity="0.28" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="24">
                <Label Text="PAUSED"
                       FontFamily="MadimiOne"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#3D2C4E" />

                <Border BackgroundColor="#FFA94D"
                        StrokeThickness="0"
                        Padding="32,14"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label Text="RESUME"
                           FontFamily="MadimiOne"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#3D2C4E">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResume" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>
