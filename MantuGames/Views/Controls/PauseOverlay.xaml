<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.PauseOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay"
          BackgroundColor="#CC0B0E14"
          InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="24">
            <Label Text="PAUSED"
                   FontFamily="Orbitron"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center">
                <Label.TextColor>
                    <AppThemeBinding Light="#E7ECF5" Dark="#E7ECF5" />
                </Label.TextColor>
            </Label>

            <Border BackgroundColor="#FF9F1C"
                    StrokeThickness="0"
                    Padding="28,12"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label Text="RESUME"
                       FontFamily="Orbitron"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#160D02">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnResume" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </VerticalStackLayout>
    </Grid>

</ContentView>
