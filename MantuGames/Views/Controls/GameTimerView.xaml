<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="MantuGames.Views.Controls.GameTimerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Padding="0,4,0,0">
        <Label x:Name="TimerLabel" Grid.Row="0" TextColor="#E7ECF5"
               FontSize="20" FontAttributes="Bold" FontFamily="Orbitron"
               HorizontalOptions="Center" Text="3:30"
               CharacterSpacing="1"/>
        <Border Grid.Row="1" x:Name="BarTrack"
                BackgroundColor="#131A29"
                StrokeThickness="0"
                HeightRequest="10"
                HorizontalOptions="Fill"
                Margin="4,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5"/>
            </Border.StrokeShape>
            <Grid>
                <Border x:Name="BarFill"
                        BackgroundColor="#22D3EE"
                        StrokeThickness="0"
                        HeightRequest="10"
                        HorizontalOptions="Start"
                        WidthRequest="300">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#22D3EE" Offset="0,0" Radius="8" Opacity="0.6"/>
                    </Border.Shadow>
                </Border>
            </Grid>
        </Border>
        <Label x:Name="TimerHint" Grid.Row="2"
               Text="" FontSize="10" HorizontalOptions="Center"
               FontAttributes="Bold" CharacterSpacing="2"/>
    </Grid>
</ContentView>