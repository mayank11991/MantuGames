<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.CoinShopPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <Grid x:Name="Overlay" BackgroundColor="#991F2A44" InputTransparent="False">
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center"
                    InputTransparent="False">
            <Grid Padding="28"
                  WidthRequest="340"
                  InputTransparent="False">

                <Border Background="#FFFFFF"
                        Stroke="#111114"
                        StrokeThickness="3"
                        Padding="24"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#2A2E45" Offset="0,8" Radius="24" Opacity="0.25" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <controls:FitLabel Text="COIN SHOP"
                               FontFamily="Display"
                               FontSize="28"
                               TextColor="#111114"
                               HorizontalOptions="Center" />

                        <Label x:Name="MessageLabel"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               TextColor="#6E6E7C"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <Label x:Name="BalanceLabel"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#111114"
                               HorizontalOptions="Center" />

                        <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                        <!-- Free coins for an opt-in rewarded ad (hidden when no ad can be shown) -->
                        <Border x:Name="FreeCoinsRow"
                                BackgroundColor="#FFF4CC"
                                Stroke="#FFC83D"
                                StrokeThickness="2"
                                Padding="14,8"
                                IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFreeCoinsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                                    <Label x:Name="FreeCoinsTitle"
                                           FontFamily="MadimiOne" FontSize="15" FontAttributes="Bold"
                                           TextColor="#111114" />
                                    <Label x:Name="FreeCoinsHint"
                                           FontFamily="MadimiOne" FontSize="11"
                                           TextColor="#6E6E7C" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#FFC83D"
                                        Stroke="#FFFFFF"
                                        StrokeThickness="2"
                                        Padding="12,6"
                                        Margin="0,0,0,4"
                                        VerticalOptions="Center"
                                        InputTransparent="True">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="999" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#D99A00" Offset="0,4" Radius="0" Opacity="1" />
                                    </Border.Shadow>
                                    <HorizontalStackLayout Spacing="5">
                                        <Image Source="ic_play_ink.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
                                        <Label Text="WATCH" FontFamily="Display" FontSize="15" TextColor="#1F2A44" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Coin packs (built in code-behind) -->
                        <VerticalStackLayout x:Name="PacksLayout" Spacing="10" />

                        <Label x:Name="StatusLabel"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#20B26B"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <!-- Close Button -->
                        <Border Style="{StaticResource CtaPillBlue}" HorizontalOptions="Center">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClose" /></Border.GestureRecognizers>
    <Label Text="CLOSE" Style="{StaticResource CtaPillLabel}" />
</Border>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>

</ContentView>