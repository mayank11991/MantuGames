<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.CoinShopPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls">

    <Grid x:Name="Overlay" BackgroundColor="#991F2A44" InputTransparent="False">
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center"
                    InputTransparent="False">
            <Grid Padding="28"
                  WidthRequest="340"
                  InputTransparent="False">

                <Border Background="#FFFFFF"
                        Stroke="#111114"
                        StrokeThickness="3"
                        Padding="24"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#2A2E45" Offset="0,8" Radius="24" Opacity="0.25" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <controls:FitLabel Text="COIN SHOP"
                               FontFamily="Display"
                               FontSize="28"
                               TextColor="#111114"
                               HorizontalOptions="Center" />

                        <Label x:Name="MessageLabel"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               TextColor="#6E6E7C"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <Label x:Name="BalanceLabel"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#111114"
                               HorizontalOptions="Center" />

                        <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                        <!-- Coin packs (built in code-behind) -->
                        <VerticalStackLayout x:Name="PacksLayout" Spacing="10" />

                        <Label x:Name="StatusLabel"
                               FontFamily="MadimiOne"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#20B26B"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <!-- Close Button -->
                        <Border Style="{StaticResource CtaPillBlue}" HorizontalOptions="Center">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClose" /></Border.GestureRecognizers>
    <Label Text="CLOSE" Style="{StaticResource CtaPillLabel}" />
</Border>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>

</ContentView>