<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.CoinShopPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="#CC0B0E14" InputTransparent="False">
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center"
                    InputTransparent="False">
            <Grid Padding="28"
                  WidthRequest="340"
                  InputTransparent="False">

                <Border Background="#182136"
                        Stroke="#2EFFFFFF"
                        StrokeThickness="1"
                        Padding="24"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.25" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <Label Text="COIN SHOP"
                               FontFamily="Orbitron"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#E7ECF5"
                               HorizontalOptions="Center" />

                        <Label x:Name="MessageLabel"
                               FontFamily="Inter"
                               FontSize="13"
                               TextColor="#9AA7BD"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <Label x:Name="BalanceLabel"
                               FontFamily="Orbitron"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#22D3EE"
                               HorizontalOptions="Center" />

                        <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                        <!-- Coin packs (built in code-behind) -->
                        <VerticalStackLayout x:Name="PacksLayout" Spacing="10" />

                        <!-- Game picker (transfer target) -->
                        <Label x:Name="PickerTitle"
                               Text="Transfer coins to game:"
                               FontFamily="Orbitron"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#E7ECF5"
                               HorizontalOptions="Center" />
                        <FlexLayout x:Name="GamesLayout"
                                    Wrap="Wrap"
                                    JustifyContent="Center"
                                    AlignItems="Center"
                                    AlignContent="Center" />

                        <Label x:Name="StatusLabel"
                               FontFamily="Inter"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#34D399"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />

                        <!-- Close Button -->
                        <Border BackgroundColor="#FF9F1C"
                                StrokeThickness="0"
                                Padding="12,8"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="CLOSE"
                                   FontFamily="Orbitron"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#160D02"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClose" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>
    </Grid>

</ContentView>