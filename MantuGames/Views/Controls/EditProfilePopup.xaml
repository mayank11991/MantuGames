<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
             x:Class="MantuGames.Views.Controls.EditProfilePopup"
             IsVisible="False">

    <Grid RowDefinitions="*">
        <!-- Dark overlay -->
        <BoxView x:Name="Overlay" Color="#99111114" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Bottom sheet -->
        <Border x:Name="Sheet"
                BackgroundColor="#FFFFFF"
                Stroke="#111114"
                StrokeThickness="3"
                VerticalOptions="End"
                Padding="24,20"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">

                <controls:FitLabel Grid.Row="0"
                       Text="EDIT PROFILE"
                       FontFamily="Display"
                       FontSize="26"
                       TextColor="#111114"
                       HorizontalOptions="Center" />

                <!-- Avatar preview -->
                <Border x:Name="AvatarPreview"
                        Grid.Row="1"
                        WidthRequest="72"
                        HeightRequest="72"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 36"
                        HorizontalOptions="Center"
                        BackgroundColor="White">
                    <Image x:Name="AvatarImage"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Name entry -->
                <Entry x:Name="NameEntry"
                       Grid.Row="2"
                       Placeholder="Enter name"
                       PlaceholderColor="#6E6E7C"
                       FontFamily="MadimiOne"
                       FontSize="16"
                       TextColor="#111114"
                       BackgroundColor="#F5F6FA"
                       MaxLength="20" />

                <!-- Avatar picker (A1-A7) -->
                <VerticalStackLayout Grid.Row="3" Spacing="8">
                    <Label Text="Choose avatar"
                           FontFamily="MadimiOne"
                           FontSize="14"
                           TextColor="#6E6E7C" />
                    <HorizontalStackLayout x:Name="AvatarPalette"
                                           Spacing="10"
                                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Save button -->
                <Border Style="{StaticResource CtaPillGreen}" Grid.Row="4" HorizontalOptions="Fill">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSave" /></Border.GestureRecognizers>
    <Label Text="SAVE" Style="{StaticResource CtaPillLabel}" />
</Border>

            </Grid>
        </Border>
    </Grid>
</ContentView>
