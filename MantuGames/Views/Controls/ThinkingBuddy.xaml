<?xml version="1.0" encoding="UTF-8" ?>
<!-- Game header buddy: the player's avatar "thinking" with a thought bubble holding the level text. -->
<ContentView
    x:Class="MantuGames.Views.Controls.ThinkingBuddy"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MantuGames.Views.Controls"
    HorizontalOptions="Center" VerticalOptions="Center">

    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="0">
        <!-- Avatar -->
        <!-- Avatar and thought dots are hidden: the header shows only the level bubble. -->
        <Border x:Name="AvatarRing" Grid.Column="0" IsVisible="False"
                WidthRequest="52" HeightRequest="52" Padding="0"
                BackgroundColor="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="3"
                VerticalOptions="End">
            <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#1F2A44" Offset="0,4" Radius="0" Opacity="0.22" /></Border.Shadow>
            <Image x:Name="AvatarImage" Source="a1.png" Aspect="AspectFill" />
        </Border>

        <!-- Trailing thought dots -->
        <Image Grid.Column="1" Source="thought_dots.png" IsVisible="False" WidthRequest="18" HeightRequest="18"
               VerticalOptions="Start" Margin="-2,2,-2,0" />

        <!-- Bubble -->
        <Border x:Name="Bubble" Grid.Column="2"
                BackgroundColor="#FFFFFF" Stroke="#1F2A44" StrokeThickness="2.5"
                Padding="14,4,14,6" VerticalOptions="Start">
            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#1F2A44" Offset="0,4" Radius="0" Opacity="0.9" /></Border.Shadow>
            <VerticalStackLayout Spacing="-6">
                <controls:FitLabel x:Name="TextLabel" SideInset="160" MinFontSize="12" Text="LEVEL 1" FontFamily="{DynamicResource ThemeTitleFont}" FontSize="20"
                       TextColor="#1F2A44" HorizontalOptions="Center" />
                <controls:FitLabel x:Name="ThoughtLabel" SideInset="160" MinFontSize="8" Text="Hmm… let me think!" FontFamily="Baloo2ExtraBold"
                       FontSize="11" TextColor="#2F8CFF" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
