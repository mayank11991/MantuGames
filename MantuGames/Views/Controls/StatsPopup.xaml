<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.StatsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="#CC0B0E14" InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Grid VerticalOptions="Center"
              HorizontalOptions="Center"
              Padding="28"
              InputTransparent="False">

            <Border Background="#182136"
                    Stroke="#2EFFFFFF"
                    StrokeThickness="1"
                    Padding="24"
                    WidthRequest="330"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <Label Text="STATISTICS"
                           FontFamily="Orbitron"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#E7ECF5"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <Label x:Name="TotalPlayedLabel"
                               FontFamily="Orbitron"
                               FontSize="14"
                               TextColor="#22D3EE" />
                        <Label x:Name="TotalWonLabel"
                               Grid.Column="1"
                               FontFamily="Orbitron"
                               FontSize="14"
                               TextColor="#34D399" />
                        <Label x:Name="TotalRateLabel"
                               Grid.Column="2"
                               FontFamily="Orbitron"
                               FontSize="14"
                               TextColor="#E7ECF5" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                    <ScrollView MaximumHeightRequest="320">
                        <Grid x:Name="StatsGrid"
                              RowDefinitions="Auto"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="12" />
                    </ScrollView>

                    <BoxView HeightRequest="1" Color="#2EFFFFFF" />

                    <Border BackgroundColor="#FF9F1C"
                            StrokeThickness="0"
                            Padding="32,10"
                            HorizontalOptions="Center"
                            MinimumWidthRequest="140">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="CLOSE"
                               FontFamily="Orbitron"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#160D02"
                               HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClose" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>