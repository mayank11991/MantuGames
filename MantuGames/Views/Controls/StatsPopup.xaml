<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MantuGames.Views.Controls.StatsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid x:Name="Overlay" BackgroundColor="#99111114" InputTransparent="False">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOverlayTapped" />
        </Grid.GestureRecognizers>
        <Grid VerticalOptions="Center"
              HorizontalOptions="Center"
              Padding="28"
              InputTransparent="False">

            <Border Background="#FFFFFF"
                    Stroke="#111114"
                    StrokeThickness="3"
                    Padding="24"
                    WidthRequest="330"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#2A2E45" Offset="0,8" Radius="24" Opacity="0.25" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <Label Text="STATISTICS"
                           FontFamily="Display"
                           FontSize="26"
                           TextColor="#111114"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <Label x:Name="TotalPlayedLabel"
                               FontFamily="MadimiOne"
                               FontSize="14"
                               TextColor="#111114" />
                        <Label x:Name="TotalWonLabel"
                               Grid.Column="1"
                               FontFamily="MadimiOne"
                               FontSize="14"
                               TextColor="#20B26B" />
                        <Label x:Name="TotalRateLabel"
                               Grid.Column="2"
                               FontFamily="MadimiOne"
                               FontSize="14"
                               TextColor="#111114" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                    <ScrollView MaximumHeightRequest="320">
                        <Grid x:Name="StatsGrid"
                              RowDefinitions="Auto"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="12" />
                    </ScrollView>

                    <BoxView HeightRequest="1" Color="#B3FFFFFF" />

                    <Border Style="{StaticResource CtaPillBlue}" HorizontalOptions="Center" WidthRequest="140">
    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnClose" /></Border.GestureRecognizers>
    <Label Text="CLOSE" Style="{StaticResource CtaPillLabel}" />
</Border>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>