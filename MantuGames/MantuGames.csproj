<Project Sdk="Microsoft.NET.Sdk">

    <!-- Local, git-ignored signing passwords (defines ANDROID_KEY_PASS / ANDROID_STORE_PASS) -->
    <Import Project="signing.local.props" Condition="Exists('signing.local.props')" />


    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
   
        <OutputType>Exe</OutputType>
        <RootNamespace>MantuGames</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

        <!-- Display name -->
        <ApplicationTitle>Mantu Games</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.mantugames.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.5.1</ApplicationDisplayVersion>
        <ApplicationVersion>17</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

            <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <!-- Release signing. Secrets never live in this file:
             - CI: ANDROID_KEY_PASS / ANDROID_STORE_PASS env vars (+ keystore decoded from a secret)
             - Local: signing.local.props next to this csproj (git-ignored), see Import below.
             The keystore file itself is git-ignored too. -->
        <AndroidKeyStore Condition="'$(Configuration)' == 'Release'">True</AndroidKeyStore>
        <AndroidSigningKeyStore Condition="'$(ANDROID_KEYSTORE_PATH)' != ''">$(ANDROID_KEYSTORE_PATH)</AndroidSigningKeyStore>
        <AndroidSigningKeyStore Condition="'$(ANDROID_KEYSTORE_PATH)' == ''">mantugames.keystore</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>mantugames</AndroidSigningKeyAlias>
        <AndroidSigningKeyPass>$(ANDROID_KEY_PASS)</AndroidSigningKeyPass>
        <AndroidSigningStorePass>$(ANDROID_STORE_PASS)</AndroidSigningStorePass>
        <!-- R8 code shrinking + ProGuard keep rules for Release builds -->
        <AndroidLinkTool Condition="'$(Configuration)' == 'Release'">r8</AndroidLinkTool>
        <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
        <AndroidProguardFile>proguard.cfg</AndroidProguardFile>
        <AndroidNativeDebugSymbols Condition="'$(Configuration)' == 'Release'">true</AndroidNativeDebugSymbols>
        <AndroidIncludeDebugSymbols Condition="'$(Configuration)' == 'Release'">true</AndroidIncludeDebugSymbols>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\app_icon.png" ForegroundFile="Resources\AppIcon\app_icon_fg.png" ForegroundScale="1" Color="#1E7BFF" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#BFE8FF" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Resource Dictionaries -->
        <MauiXaml Update="Resources/Styles/Colors.xaml" />
        <MauiXaml Update="Resources/Styles/Styles.xaml" />
        <Compile Update="Resources/Styles/Colors.xaml.cs">
            <DependentUpon>Colors.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Resources/Styles/Styles.xaml.cs">
            <DependentUpon>Styles.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
        <PackageReference Include="Plugin.MauiMTAdmob" Version="2.4.0" />
        <PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <MauiXaml Update="Views\LevelMapPage.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
        <MauiXaml Update="Views\SudokuPage.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
        <MauiXaml Update="Views\Controls\GameTimerView.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
        <MauiXaml Update="Views\Controls\GameResultPopup.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\DashboardPage.xaml.cs">
            <DependentUpon>DashboardPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\LevelMapPage.xaml.cs">
            <DependentUpon>LevelMapPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\SudokuPage.xaml.cs">
            <DependentUpon>SudokuPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Controls\GameTimerView.xaml.cs">
            <DependentUpon>GameTimerView.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Controls\GameResultPopup.xaml.cs">
            <DependentUpon>GameResultPopup.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Views\DashboardPage.xaml" />
    </ItemGroup>

    <!-- Animal Crush is paused (not in the current release). Its page and view model are kept
         in the repo but not compiled into the app. Models/AnimalCrushPuzzle.cs stays in the
         build because MantuGames.Tests covers it. To bring the game back: delete this block,
         re-enable its route in AppShell.xaml.cs and add it to DashboardViewModel.Games. -->
    <ItemGroup>
      <MauiXaml Remove="Views\AnimalCrushPage.xaml" />
      <None Include="Views\AnimalCrushPage.xaml" />
      <Compile Remove="Views\AnimalCrushPage.xaml.cs;ViewModels\AnimalCrushViewModel.cs" />
      <None Include="Views\AnimalCrushPage.xaml.cs;ViewModels\AnimalCrushViewModel.cs" />
    </ItemGroup>

</Project>
