<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
   
        <OutputType>Exe</OutputType>
        <RootNamespace>MantuGames</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

        <!-- Display name -->
        <ApplicationTitle>Mantu Games</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.mantugames.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
        <ApplicationVersion>3</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

            <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
        <AndroidKeyStore>True</AndroidKeyStore>
        <AndroidSigningKeyStore>mantugames.keystore</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>mantugames</AndroidSigningKeyAlias>
        <!-- Signing passwords: use env vars (recommended for CI) or fall back to local values -->
        <AndroidSigningKeyPass Condition="'$(ANDROID_KEY_PASS)' != ''">$(ANDROID_KEY_PASS)</AndroidSigningKeyPass>
        <AndroidSigningKeyPass Condition="'$(ANDROID_KEY_PASS)' == ''">Xamarin@11991</AndroidSigningKeyPass>
        <AndroidSigningStorePass Condition="'$(ANDROID_STORE_PASS)' != ''">$(ANDROID_STORE_PASS)</AndroidSigningStorePass>
        <AndroidSigningStorePass Condition="'$(ANDROID_STORE_PASS)' == ''">Xamarin@11991</AndroidSigningStorePass>
        <!-- R8 code shrinking + ProGuard keep rules for Release builds -->
        <AndroidLinkTool Condition="'$(Configuration)' == 'Release'">r8</AndroidLinkTool>
        <AndroidProguardFile>proguard.cfg</AndroidProguardFile>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B0E14" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Resource Dictionaries -->
        <MauiXaml Update="Resources/Styles/Colors.xaml" />
        <MauiXaml Update="Resources/Styles/Styles.xaml" />
        <Compile Update="Resources/Styles/Colors.xaml.cs">
            <DependentUpon>Colors.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Resources/Styles/Styles.xaml.cs">
            <DependentUpon>Styles.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
        <PackageReference Include="Plugin.MauiMTAdmob" Version="2.4.0" />
        <PackageReference Include="Plugin.InAppBilling" Version="5.0.1" />
    </ItemGroup>

    <ItemGroup>
        <MauiXaml Update="Views\LevelMapPage.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
        <MauiXaml Update="Views\SudokuPage.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
        <MauiXaml Update="Views\Controls\GameTimerView.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
        <MauiXaml Update="Views\Controls\GameResultPopup.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\DashboardPage.xaml.cs">
            <DependentUpon>DashboardPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\LevelMapPage.xaml.cs">
            <DependentUpon>LevelMapPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\SudokuPage.xaml.cs">
            <DependentUpon>SudokuPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Controls\GameTimerView.xaml.cs">
            <DependentUpon>GameTimerView.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Controls\GameResultPopup.xaml.cs">
            <DependentUpon>GameResultPopup.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Views\DashboardPage.xaml" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="obj\Debug\net10.0-android\MantuGames.genruntimeconfig.cache" />
      <Content Include="obj\Debug\net10.0-android\MantuGames.sourcelink.json" />
      <Content Include="obj\Debug\net10.0-android\XamlC.stamp" />
      <Content Include="obj\Debug\net10.0-android\_Microsoft.Android.Resource.Designer.dll" />
      <Content Include="obj\rider.project.restore.info" />
    </ItemGroup>

</Project>
