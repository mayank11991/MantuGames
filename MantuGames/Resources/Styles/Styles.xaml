<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MantuGames.Resources.Styles.Styles">

    <!-- ══════════════════════════════════════════════════════════════
         Mantu Games — Claymorphism styles
         Rounded Baloo 2 type, pastel surfaces, white rims and soft
         plum shadows. MadimiOne is aliased to Baloo 2 in MauiProgram.
         ══════════════════════════════════════════════════════════════ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBg}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource ColorBg}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource ColorText}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource ColorText}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Gray500}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Gray400}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray400}" />
    </Style>

    <!-- ── Typography ────────────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.12" />
    </Style>

    <Style TargetType="Label" x:Key="DisplayLabel">
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="LineHeight" Value="1.05" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="FontFamily" Value="Baloo2SemiBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource ColorMuted}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="KickerLabel">
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <Style TargetType="Label" x:Key="MutedLabel">
        <Setter Property="TextColor" Value="{StaticResource ColorMuted}" />
        <Setter Property="FontFamily" Value="MadimiOne" />
    </Style>

    <Style TargetType="Label" x:Key="ClayTitle">
        <Setter Property="FontFamily" Value="Baloo2ExtraBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
    </Style>

    <Style TargetType="Label" x:Key="ClaySubtitle">
        <Setter Property="FontFamily" Value="Baloo2SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource ColorMuted}" />
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────────── -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource ColorLine}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,6" Radius="14" Opacity="0.30" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray900}" />
                            <Setter Property="Shadow" Value="{x:Null}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="AccentButton">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource ColorLine}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,6" Radius="14" Opacity="0.30" />
        </Setter>

        <Setter Property="BackgroundColor" Value="{StaticResource ColorCta}" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource ColorLine}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,6" Radius="14" Opacity="0.30" />
        </Setter>

        <Setter Property="BackgroundColor" Value="#CCFFFFFF" />
        <Setter Property="BorderColor" Value="{StaticResource ColorLine}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Button" x:Key="ClayPrimaryButton">
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{StaticResource ColorLine}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,6" Radius="14" Opacity="0.30" />
        </Setter>

        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!-- ── Cards / panels ────────────────────────────────────────── -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Stroke" Value="{StaticResource ColorLine}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="24" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,8" Radius="18" Opacity="0.28" />
        </Setter>
    </Style>

    <!-- Former <Frame> panels (Frame is obsolete since .NET 9): same fill, corners and clay shadow, no stroke. -->
    <Style TargetType="Border" x:Key="ClayFrame">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,6" Radius="14" Opacity="0.26" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="PanelCard">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Stroke" Value="{StaticResource ColorLine}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="24" />
        </Setter>
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,8" Radius="18" Opacity="0.28" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ClayCard" BasedOn="{StaticResource PanelCard}" />

    <Style TargetType="Border" x:Key="ClayCardPink" BasedOn="{StaticResource PanelCard}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel3}" />
    </Style>

    <Style TargetType="Border" x:Key="ClayCardMint" BasedOn="{StaticResource PanelCard}">
        <Setter Property="BackgroundColor" Value="#DDFBF2" />
    </Style>

    <Style TargetType="Border" x:Key="ClayCardSky" BasedOn="{StaticResource PanelCard}">
        <Setter Property="BackgroundColor" Value="#E2F6FF" />
    </Style>

    <Style TargetType="Border" x:Key="ClayPill">
        <Setter Property="BackgroundColor" Value="#D9FFFFFF" />
        <Setter Property="Stroke" Value="{StaticResource ColorLine}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,4" Radius="10" Opacity="0.22" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ClayIconPill">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Stroke" Value="{StaticResource ColorLine}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ColorClayShadow}" Offset="0,4" Radius="10" Opacity="0.24" />
        </Setter>
    </Style>

    <!-- ── Inputs ────────────────────────────────────────────────── -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="TitleColor" Value="{StaticResource Gray400}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource ColorMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource ColorMint}" />
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource Gray600}" />
        <Setter Property="ThumbColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{StaticResource Gray600}" />
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="18" />
        <Setter Property="Opacity" Value="0.28" />
        <Setter Property="Brush" Value="{StaticResource ColorClayShadow}" />
        <Setter Property="Offset" Value="0,8" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource ColorBg}" />
        <Setter Property="BarTextColor" Value="{StaticResource ColorText}" />
        <Setter Property="IconColor" Value="{StaticResource ColorText}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="BarTextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="UnselectedTabColor" Value="{StaticResource Gray400}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource ColorAccent}" />
    </Style>

</ResourceDictionary>
