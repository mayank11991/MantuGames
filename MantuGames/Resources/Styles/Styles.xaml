<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MantuGames.Resources.Styles.Styles">

    <!-- ══════════════════════════════════════════════════════════════
         Mantu Games — "Pop" styles (see Colors.xaml).
         Display type: Anton ("Display"). Body: Baloo 2; MadimiOne and
         other legacy font names are aliased to Baloo 2 in MauiProgram.
         ══════════════════════════════════════════════════════════════ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBg}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource ColorBg}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource ColorText}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource ColorText}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Gray500}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Gray400}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray400}" />
    </Style>

    <!-- ── Typography ────────────────────────────────────────────── -->
    <!-- Display = Anton (tall condensed). Body = Baloo 2 (MadimiOne alias). -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource PopInk}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.12" />
    </Style>

    <Style TargetType="Label" x:Key="PopHero">
        <Setter Property="FontFamily" Value="{DynamicResource ThemeTitleFont}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="TextColor" Value="{StaticResource PopInk}" />
        <Setter Property="LineHeight" Value="0.95" />
    </Style>
    <Style TargetType="Label" x:Key="PopTitle">
        <Setter Property="FontFamily" Value="{DynamicResource ThemeTitleFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource PopInk}" />
        <Setter Property="LineHeight" Value="1" />
    </Style>
    <Style TargetType="Label" x:Key="PopSection">
        <Setter Property="FontFamily" Value="{DynamicResource ThemeTitleFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource PopInk}" />
    </Style>
    <Style TargetType="Label" x:Key="PopBody">
        <Setter Property="FontFamily" Value="Baloo2Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource PopInkSoft}" />
    </Style>
    <Style TargetType="Label" x:Key="PopMutedLabel">
        <Setter Property="FontFamily" Value="Baloo2Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource PopMuted}" />
    </Style>
    <Style TargetType="Label" x:Key="NightTitle">
        <Setter Property="FontFamily" Value="{DynamicResource ThemeTitleFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource NightText}" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>
    <Style TargetType="Label" x:Key="NightBody">
        <Setter Property="FontFamily" Value="Baloo2SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource NightMuted}" />
    </Style>

    <!-- Legacy label keys, restyled -->
    <Style TargetType="Label" x:Key="DisplayLabel" BasedOn="{StaticResource PopTitle}">
        <Setter Property="FontSize" Value="36" />
    </Style>
    <Style TargetType="Label" x:Key="Headline" BasedOn="{StaticResource PopTitle}">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label" x:Key="SubHeadline" BasedOn="{StaticResource PopBody}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label" x:Key="KickerLabel">
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource PopMuted}" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>
    <Style TargetType="Label" x:Key="MutedLabel" BasedOn="{StaticResource PopMutedLabel}" />
    <Style TargetType="Label" x:Key="ClayTitle" BasedOn="{StaticResource PopTitle}" />
    <Style TargetType="Label" x:Key="ClaySubtitle" BasedOn="{StaticResource PopBody}" />

    <!-- ── Buttons ───────────────────────────────────────────────── -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="BackgroundColor" Value="{StaticResource PopInk}" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="MinimumWidthRequest" Value="50" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Gray400}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PopPaperSoft}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="AccentButton">
        <Setter Property="TextColor" Value="{StaticResource PopInk}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PopLime}" />
        <Setter Property="FontFamily" Value="Baloo2ExtraBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderColor" Value="{StaticResource PopInk}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>
    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="TextColor" Value="{StaticResource PopInk}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PopPaper}" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderColor" Value="{StaticResource PopInk}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>
    <Style TargetType="Button" x:Key="ClayPrimaryButton">
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="BackgroundColor" Value="{StaticResource PopInk}" />
        <Setter Property="FontFamily" Value="Baloo2Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!-- ── Cards / panels ────────────────────────────────────────── -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PopPaper}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="24" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource PopShadow}" Offset="0,8" Radius="18" Opacity="0.12" />
        </Setter>
    </Style>
    <!-- Former <Frame> panels. -->
    <Style TargetType="Border" x:Key="ClayFrame">
        <Setter Property="BackgroundColor" Value="{StaticResource PopPaper}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource PopShadow}" Offset="0,6" Radius="14" Opacity="0.12" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="PopCard">
        <Setter Property="BackgroundColor" Value="{StaticResource PopPaper}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="28" />
        </Setter>
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource PopShadow}" Offset="0,10" Radius="22" Opacity="0.14" />
        </Setter>
    </Style>
    <!-- Black pill (primary action / active nav) -->
    <Style TargetType="Border" x:Key="PopPillDark">
        <Setter Property="BackgroundColor" Value="{StaticResource PopInk}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Shadow">
            <Shadow Brush="#000000" Offset="0,8" Radius="16" Opacity="0.22" />
        </Setter>
    </Style>
    <!-- White pill with ink outline -->
    <Style TargetType="Border" x:Key="PopPillLight">
        <Setter Property="BackgroundColor" Value="{StaticResource PopPaper}" />
        <Setter Property="Stroke" Value="{StaticResource PopInk}" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>
    <!-- Round icon button (white, ink outline) -->
    <Style TargetType="Border" x:Key="PopCircle">
        <Setter Property="BackgroundColor" Value="{StaticResource PopPaper}" />
        <Setter Property="Stroke" Value="{StaticResource PopInk}" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>
    <!-- Soft white round button (no outline) -->
    <Style TargetType="Border" x:Key="PopCircleSoft">
        <Setter Property="BackgroundColor" Value="#E6FFFFFF" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource PopShadow}" Offset="0,4" Radius="10" Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Night (game) surfaces -->
    <Style TargetType="Border" x:Key="NightCard">
        <Setter Property="BackgroundColor" Value="{StaticResource NightSurface}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="24" />
        </Setter>
        <Setter Property="Padding" Value="12" />
        <Setter Property="Shadow">
            <Shadow Brush="#2A6FB8" Offset="0,6" Radius="0" Opacity="0.25" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="NightCircle">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SkinButton}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource SkinButtonLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="NightAction">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{StaticResource CtaYellow}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CtaYellowLip}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaCircleBlue">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SkinButton}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource SkinButtonLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaCircleYellow">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CircleYellow}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource CircleYellowLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaCircleGreen">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CircleGreen}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource CircleGreenLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaCirclePink">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CirclePink}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource CirclePinkLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaCircleOrange">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CircleOrange}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource CircleOrangeLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CtaButtonYellow">
        <!-- room for the hard-shadow lip so parents don't clip it -->
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="BackgroundColor" Value="{StaticResource CtaYellow}" />
        <Setter Property="TextColor" Value="#1F2A44" />
        <Setter Property="FontFamily" Value="Baloo2ExtraBold" />
        <Setter Property="BorderColor" Value="#FFFFFF" />
        <Setter Property="BorderWidth" Value="3" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CtaYellowLip}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="CtaPillBlue">
        <Setter Property="BackgroundColor" Value="{DynamicResource SkinButton}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Shadow">
            <Shadow Brush="{DynamicResource SkinButtonLipBrush}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaPillOrange">
        <Setter Property="BackgroundColor" Value="{StaticResource CtaOrange}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CtaOrangeLip}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaPillGreen">
        <Setter Property="BackgroundColor" Value="{StaticResource CtaGreen}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CtaGreenLip}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaPillYellow">
        <Setter Property="BackgroundColor" Value="{StaticResource CtaYellow}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CtaYellowLip}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Border" x:Key="CtaPillPink">
        <Setter Property="BackgroundColor" Value="{StaticResource CtaPink}" />
        <Setter Property="Stroke" Value="#FFFFFF" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CtaPinkLip}" Offset="0,5" Radius="0" Opacity="1" />
        </Setter>
    </Style>
    <Style TargetType="Label" x:Key="CtaPillLabel">
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="FontFamily" Value="{DynamicResource ThemeTitleFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>
    <Style TargetType="Label" x:Key="CtaPillLabelDark" BasedOn="{StaticResource CtaPillLabel}">
        <Setter Property="TextColor" Value="#1F2A44" />
    </Style>

    <Style TargetType="Border" x:Key="NightPill">
        <Setter Property="BackgroundColor" Value="{StaticResource NightSurface}" />
        <Setter Property="Stroke" Value="{StaticResource NightLine}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <!-- Legacy card keys -->
    <Style TargetType="Border" x:Key="PanelCard" BasedOn="{StaticResource PopCard}" />
    <Style TargetType="Border" x:Key="ClayCard" BasedOn="{StaticResource PopCard}" />
    <Style TargetType="Border" x:Key="ClayCardPink" BasedOn="{StaticResource PopCard}">
        <Setter Property="BackgroundColor" Value="#FFF0F6" />
    </Style>
    <Style TargetType="Border" x:Key="ClayCardMint" BasedOn="{StaticResource PopCard}">
        <Setter Property="BackgroundColor" Value="#E6FAEF" />
    </Style>
    <Style TargetType="Border" x:Key="ClayCardSky" BasedOn="{StaticResource PopCard}">
        <Setter Property="BackgroundColor" Value="#DDEBFF" />
    </Style>
    <Style TargetType="Border" x:Key="ClayPill" BasedOn="{StaticResource PopPillLight}" />
    <Style TargetType="Border" x:Key="ClayIconPill" BasedOn="{StaticResource PopCircle}">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <!-- ── Inputs ────────────────────────────────────────────────── -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="TitleColor" Value="{StaticResource Gray400}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource ColorMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="MadimiOne" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource PopGreen}" />
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <Style TargetType="Slider">
