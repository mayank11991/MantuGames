<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MantuGames.Resources.Styles.Styles">

    <!-- ══════════════════════════════════════════════════════════════
         Mantu Games — website design system styles
         Fonts: Orbitron (display) + Inter (body), registered in MauiProgram
         ══════════════════════════════════════════════════════════════ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBg}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource ColorBg}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource ColorText}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource ColorText}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Gray600}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Gray400}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource ColorBg2}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray400}" />
    </Style>

    <!-- ── Typography ────────────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="DisplayLabel">
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="KickerLabel">
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="CharacterSpacing" Value="3" />
    </Style>

    <Style TargetType="Label" x:Key="MutedLabel">
        <Setter Property="TextColor" Value="{StaticResource ColorMuted}" />
        <Setter Property="FontFamily" Value="Inter" />
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────────── -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray900}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Orange gradient CTA (matches .btn-accent) -->
    <Style TargetType="Button" x:Key="AccentButton">
        <Setter Property="TextColor" Value="{StaticResource ColorOnDark}" />
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorCta}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <!-- Ghost pill (matches .btn-ghost) -->
    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="Orbitron" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="#0FFFFFFF" />
        <Setter Property="BorderColor" Value="{StaticResource ColorLineStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <!-- ── Cards / panels (matches .game-card, .feature-card) ────── -->
    <Style TargetType="Border" x:Key="PanelCard">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel}" />
        <Setter Property="Stroke" Value="{StaticResource ColorLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="14" />
        </Setter>
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource ColorLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <!-- ── Inputs ────────────────────────────────────────────────── -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBg2}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="TitleColor" Value="{StaticResource Gray300}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource Gray400}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorText}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="ThumbColor" Value="{StaticResource ColorText}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource Gray600}" />
        <Setter Property="ThumbColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{StaticResource Gray600}" />
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource ColorAccent}" />
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="20" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Brush" Value="{StaticResource Black}" />
        <Setter Property="Offset" Value="0,8" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPanel2}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource ColorBg}" />
        <Setter Property="BarTextColor" Value="{StaticResource ColorText}" />
        <Setter Property="IconColor" Value="{StaticResource ColorText}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource ColorBg2}" />
        <Setter Property="BarTextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="UnselectedTabColor" Value="{StaticResource Gray400}" />
        <Setter Property="SelectedTabColor" Value="{StaticResource ColorAccent}" />
    </Style>

</ResourceDictionary>